					<text><![CDATA[Estado]]></text>
					<printWhenExpression><![CDATA[$F{horario} != null]]></printWhenExpression>
				</element>
				<element kind="staticText" uuid="a1d10010-0000-4000-8000-000000000007" x="0" y="30" width="555" height="20" forecolor="#5B6B62" fontSize="10.0" italic="true" vTextAlign="Middle">
					<text><![CDATA[Sin servicios programados para esta fecha.]]></text>
					<printWhenExpression><![CDATA[$F{horario} == null]]></printWhenExpression>
				</element>
				<element kind="line" uuid="a1d10010-0000-4000-8000-000000000008" x="0" y="53" width="555" height="1" forecolor="#E4DFCB"/>
			</band>
		</groupHeader>
		<groupFooter>
			<band height="22"/>
		</groupFooter>
	</group>
