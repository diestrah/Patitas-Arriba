<!-- Reporte de agenda diaria (RF13). Disenado en Jaspersoft Studio 7.0.8; se llama con: CALL reporte_agenda_diaria(fecha, id_veterinario) -->
<jasperReport name="Reporte_AgendaDiaria" whenNoDataType="NoDataSection" language="java" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="94403d57-b3f6-471e-930c-05b34b3215b9">
	<property name="com.jaspersoft.studio.data.defaultdataadapter" value="patitasarriba_local"/>
	<parameter name="fecha" class="java.sql.Date">
		<defaultValueExpression><![CDATA[java.sql.Date.valueOf("2026-11-20")]]></defaultValueExpression>
	</parameter>
	<parameter name="id_veterinario" class="java.lang.Integer"/>
	<parameter name="logo" class="java.awt.Image">
		<description><![CDATA[Logo de la clinica. Lo envia el REST; el valor por defecto es solo para la vista previa de Studio]]></description>
		<defaultValueExpression><![CDATA[javax.imageio.ImageIO.read(new java.io.File("C:/Users/ASUS/Desktop/6to_Ciclo/PROG3/Patitas-Arriba/BackEnd/patitasarriba-reportes/imagenes/logo-patitas.png"))]]></defaultValueExpression>
	</parameter>
	<parameter name="generado_por" class="java.lang.String">
		<description><![CDATA[Nombre de quien genera el reporte (opcional)]]></description>
	</parameter>
	<query language="SQL"><![CDATA[CALL reporte_agenda_diaria($P{fecha}, $P{id_veterinario})]]></query>
	<field name="veterinario" class="java.lang.String"/>
	<field name="horario" class="java.lang.String"/>
	<field name="mascota" class="java.lang.String"/>
	<field name="cliente" class="java.lang.String"/>
	<field name="servicio" class="java.lang.String"/>
	<field name="estado" class="java.lang.String"/>
	<field name="emergencia" class="java.lang.Boolean"/>
	<variable name="TOTAL" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{horario} != null ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="ATENDIDOS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA["Atendido".equals($F{estado}) ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="POR_ATENDER" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA["Por atender".equals($F{estado}) ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="POR_APROBAR" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA["Por aprobar".equals($F{estado}) ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="EMERGENCIAS" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[Boolean.TRUE.equals($F{emergencia}) ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="SERV_VET" resetType="Group" resetGroup="veterinario" calculation="Sum" class="java.lang.Integer">
		<expression><![CDATA[$F{horario} != null ? 1 : 0]]></expression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<group name="veterinario">
		<expression><![CDATA[$F{veterinario}]]></expression>
		<groupHeader>
			<band height="56">
				<element kind="textField" uuid="a1d10010-0000-4000-8000-000000000001" x="0" y="4" width="380" height="22" fontSize="12.0" bold="true">
					<expression><![CDATA[$F{veterinario}]]></expression>
				</element>
				<element kind="textField" uuid="a1d10010-0000-4000-8000-000000000009" x="380" y="4" width="175" height="22" forecolor="#8A8A8A" fontSize="10.0" hTextAlign="Right" vTextAlign="Middle" evaluationTime="Group" evaluationGroup="veterinario">
					<expression><![CDATA[($V{SERV_VET} == 0 ? "" : $V{SERV_VET} + ($V{SERV_VET} == 1 ? " servicio" : " servicios"))]]></expression>
				</element>
				<element kind="staticText" uuid="a1d10010-0000-4000-8000-000000000002" x="0" y="30" width="95" height="20" fontSize="10.0" bold="true" vTextAlign="Middle">
