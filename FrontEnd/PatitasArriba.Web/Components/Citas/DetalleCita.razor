<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Cita N.° @Cita.Id · @Cita.NombreMascota</span>
        <BadgeEstadoCita Estado="Cita.Estado" />
    </div>
    <div class="card-body">
        <ul class="list-unstyled small mb-3">
            <li><strong>Cliente:</strong> @Cita.NombreCliente</li>
            <li><strong>Fecha y hora:</strong> @(Cita.FechaHora?.ToString("dd/MM/yyyy HH:mm"))</li>
            <li>
                @* Sin @if: Blazor borra el espacio pegado a un bloque @if y quedaba «Emergencia:No» *@
                <strong>Emergencia:</strong>
                <span class="@(Cita.EsEmergencia ? "badge text-bg-danger" : "")">@(Cita.EsEmergencia ? "Sí" : "No")</span>
            </li>
            <li><strong>Revisada por:</strong> @(Cita.NombreAdministrador ?? "Pendiente de revisión")</li>
        </ul>

        <h6>Servicios solicitados</h6>
        <table class="table table-sm mb-0">
            <thead>
                <tr>
                    <th>Servicio</th>
                    <th>Veterinario</th>
                    @if (Atendidos != null) {
                        <th>Atención</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DetalleCitaViewModel detalle in Cita.Detalles) {
                    <tr>
                        <td>@detalle.NombreServicio</td>
                        <td>@detalle.NombreVeterinario</td>
                        @if (Atendidos != null) {
                            <td>
                                @if (Atendidos.Activa(detalle.Id)) {
                                    <span class="estado estado-aprobado">Atendido</span>
                                } else if (Atendidos.Anulada(detalle.Id)) {
                                    <span class="estado estado-cancelado" title="Su atención se anuló: queda como no realizado">Anulado</span>
                                } else {
                                    <span class="estado estado-cancelado">Por atender</span>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (ChildContent != null) {
        <div class="card-footer d-flex flex-wrap gap-2">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public CitaViewModel Cita { get; set; } = default!;

    // Atenciones de los servicios (detalle_cita), activas o anuladas; si se envía, se muestra la columna "Atención"
    [Parameter]
    public AtencionesDeCitas? Atendidos { get; set; }

    // Acciones según quién ve la cita (administrador o cliente)
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
