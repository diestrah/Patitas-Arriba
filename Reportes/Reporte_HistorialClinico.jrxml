				<element kind="staticText" uuid="b2e20002-0000-4000-8000-000000000088" x="10" y="0" width="95" height="16" forecolor="#5B6B62" fontSize="9.5" bold="true">
					<text><![CDATA[Veterinario]]></text>
				</element>
