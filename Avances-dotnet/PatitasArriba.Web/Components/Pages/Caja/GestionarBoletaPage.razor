@page "/boletas/nueva"
@inject NavigationManager Nav;
@inject IBoletaService BoletaService;
@inject IClienteService ClienteService;
@inject IArticuloService ArticuloService;
@inject ICitaService CitaService;
@inject IAtencionService AtencionService;
@inject IServicioService ServicioService;

<PageTitle>Nueva boleta</PageTitle>

<h3 class="mb-1">Nueva boleta</h3>
<p class="text-muted mb-3">Cobre las atenciones ya registradas por el veterinario y, si lo desea, sume una venta en caja.</p>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@* Sin botón de envío: Enter en el DNI busca al cliente y no emite la boleta. La boleta se emite con "Generar boleta" *@
<EditForm EditContext="Contexto">
    <DataAnnotationsValidator />

    <div class="row g-4">
        <div class="col-lg-7 d-flex flex-column gap-3">
            <div class="card">
                <div class="card-header fw-bold d-flex align-items-center"><span class="paso-num">1</span>Cliente</div>
                <div class="card-body">
                    @* Con muchos clientes una lista desplegable no es práctica: se busca por DNI (GET /clientes?dni=...) *@
                    <label class="form-label" for="dni-buscar">DNI del cliente</label>
                    <div class="input-group">
                        <input id="dni-buscar" tabindex="1" class="form-control" maxlength="8" placeholder="Ingrese el DNI (8 dígitos)"
                               @bind="DniBuscar" @bind:event="oninput" @onkeydown="TeclaEnDni" />
                        <button tabindex="2" type="button" class="btn btn-primary btn-texto" disabled="@Buscando" @onclick="() => BuscarCliente()">
                            <Icono Nombre="search" /><span>@(Buscando ? "Buscando..." : "Buscar")</span>
                        </button>
                    </div>
                    @if (MensajeCliente != null) {
                        <div class="validation-message mt-1">@MensajeCliente</div>
                    }
                    @if (ViewModel.IdCliente != 0) {
                        <div class="alert alert-success mt-3 mb-0">
                            <strong>@ViewModel.NombreCliente</strong> · DNI @ViewModel.DniCliente ·
                            @(Pendientes.Count == 0 ? "sin atenciones por cobrar" : $"S/ {Pendientes.Sum(l => l.SubTotal):N2} por cobrar")
                        </div>
                    }
                    <ValidationMessage For="() => ViewModel.IdCliente" />
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-bold d-flex align-items-center"><span class="paso-num">2</span>Atenciones por cobrar</div>
                <div class="card-body d-flex flex-column gap-2">
                    @if (ViewModel.IdCliente == 0) {
                        <span class="text-muted">Busque al cliente para ver lo que tiene pendiente de cobro.</span>
                    } else if (Pendientes.Count == 0) {
                        <div class="alert alert-warning mb-0">@ViewModel.NombreCliente no tiene servicios ni insumos pendientes de cobro. Solo puede hacer una venta en caja (paso 3).</div>
                    } else {
                        @* Si el cliente no lo paga ahora, se desmarca y sigue pendiente *@
                        @foreach (LineaBoletaViewModel linea in Pendientes) {
                            bool marcada = Marcadas.Contains(linea);
                            <label class="opcion-cobro @(marcada ? "marcada" : "")">
                                <input type="checkbox" class="form-check-input mt-0" checked="@marcada" @onchange="e => Marcar(linea, e.Value is true)" />
                                <span class="flex-grow-1">
                                    <strong>@linea.Descripcion</strong>
                                    @if (linea.Tipo == "Insumo") {
                                        <span class="badge text-bg-light border ms-1">Cobrable</span>
                                    }
                                    @if (linea.Cantidad > 1) {
                                        <span class="small text-muted"> × @linea.Cantidad</span>
                                    }
                                </span>
                                <strong>S/ @linea.SubTotal.ToString("N2")</strong>
                            </label>
                        }
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header fw-bold d-flex align-items-center">
                    <span class="paso-num">3</span>Venta en caja <span class="text-muted fw-normal ms-2 small">(opcional, no necesita atención)</span>
                </div>
                <div class="card-body">
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <select class="form-select w-auto flex-grow-1" aria-label="Artículo" @bind="IdArticuloAgregar">
                            <option value="0">Seleccione un artículo</option>
                            @foreach (ArticuloViewModel articulo in Articulos) {
                                <option value="@articulo.Id">@articulo.Nombre · S/ @articulo.PrecioBase.ToString("N2") (stock @articulo.StockActual)</option>
                            }
                        </select>
                        <input type="number" min="1" class="form-control w-auto" style="width: 5rem !important" aria-label="Cantidad" @bind="CantidadAgregar" />
                        <button type="button" class="btn btn-secondary btn-texto" @onclick="() => AgregarArticulo()">
                            <Icono Nombre="plus" /><span>Agregar</span>
                        </button>
                    </div>
                    @if (MensajeArticulo != null) {
                        <div class="alert alert-warning">@MensajeArticulo</div>
                    }
                    @foreach (LineaBoletaViewModel linea in Vendidos) {
                        <div class="d-flex align-items-center justify-content-between gap-2 border rounded-3 px-3 py-2 mb-2">
                            <span><strong>@linea.Descripcion</strong> × @linea.Cantidad</span>
                            <span class="d-flex align-items-center gap-2">
                                <strong>S/ @linea.SubTotal.ToString("N2")</strong>
                                <button type="button" class="btn btn-outline-danger btn-icono" title="Quitar" aria-label="@($"Quitar {linea.Descripcion}")" @onclick="() => QuitarVenta(linea)">
                                    <Icono Nombre="trash" />
                                </button>
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card sticky-lateral">
                <div class="card-header fw-bold">Resumen</div>
                <div class="card-body d-flex flex-column gap-3">
                    <TicketBoleta Boleta="ViewModel" />
                    <p class="form-text mb-0">Los precios salen del catálogo; no se escriben a mano (RN-BO-05).</p>
                    <div>
                        <div class="fw-bold small mb-1">Método de pago</div>
                        <div class="seg-pago">
                            @foreach (MetodoPago metodo in Metodos) {
                                <button type="button" class="@(metodo == ViewModel.MetodoPago ? "activo" : "")" aria-pressed="@(metodo == ViewModel.MetodoPago)" @onclick="() => ViewModel.MetodoPago = metodo">
                                    @TextoEnum.De(metodo)
                                </button>
                            }
                        </div>
                    </div>
                    <ValidationMessage For="() => ViewModel.Lineas" />
                    <button tabindex="4" type="button" class="btn btn-primary btn-texto justify-content-center" disabled="@Guardando" @onclick="() => Emitir()">
                        <Icono Nombre="file-text" /><span>@(Guardando ? "Generando..." : $"Generar boleta · S/ {ViewModel.Total:N2}")</span>
                    </button>
                    <a tabindex="5" class="btn btn-outline-primary" href="boletas">Cancelar</a>
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    private BoletaViewModel ViewModel { get; set; } = new();
    private EditContext Contexto { get; set; } = default!;
    private List<ArticuloViewModel> Articulos { get; set; } = [];
    private MetodoPago[] Metodos { get; } = Enum.GetValues<MetodoPago>();

    // Pendientes del cliente (con las marcadas para cobrar ahora) y lo vendido en caja: juntos forman ViewModel.Lineas
    private List<LineaBoletaViewModel> Pendientes { get; set; } = [];
    private HashSet<LineaBoletaViewModel> Marcadas { get; set; } = [];
    private List<LineaBoletaViewModel> Vendidos { get; set; } = [];

    private string DniBuscar { get; set; } = "";
    private string? MensajeCliente { get; set; }
    private int IdArticuloAgregar { get; set; }
    private int CantidadAgregar { get; set; } = 1;
    private string? MensajeArticulo { get; set; }

    // Mensaje del backend cuando rechace la boleta
    private string? MensajeError { get; set; }
    private bool Buscando { get; set; }
    private bool Guardando { get; set; }

    // El número (B001-000123) lo asigna el backend al emitir (RN-BO-03): así no se repite aunque haya anuladas
    private const string NumeroAlEmitir = "N.° al emitir";

    protected override void OnInitialized() {
        ViewModel.SerieCorrelativo = NumeroAlEmitir;
        Contexto = new EditContext(ViewModel);
    }

    // GET /articulos para la venta en caja. Solo en la pasada interactiva: así el prerenderizado no repite la consulta
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Articulos = (await ArticuloService.FindAll()).OrderBy(a => a.Nombre).ToList();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
    }

    private async Task TeclaEnDni(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            await BuscarCliente();
        }
    }

    // Busca al cliente por DNI (GET /clientes?dni=...) y carga SOLO lo que ese cliente tiene pendiente de cobro (RN-BO-04)
    private async Task BuscarCliente() {
        if (Buscando) return;
        MensajeCliente = null;
        string dni = DniBuscar.Trim();
        if (dni.Length != 8 || !dni.All(char.IsDigit)) {
            MensajeCliente = "El DNI debe tener 8 dígitos";
            return;
        }
        Buscando = true;
        try {
            ClienteViewModel? cliente = await ClienteService.FindByDni(dni);
            if (cliente == null) {
                MensajeCliente = $"No hay un cliente activo con el DNI {dni}. Regístrelo primero en Clientes.";
                return;
            }
            List<LineaBoletaViewModel> pendientes = await CobrosPendientes.DelCliente(cliente.Id,
                CitaService, AtencionService, BoletaService, ServicioService);

            ViewModel.IdCliente = cliente.Id;
            ViewModel.NombreCliente = cliente.NombreCompleto;
            ViewModel.DniCliente = cliente.Dni;

            // Al cambiar de cliente se descartan los pendientes del anterior (los vendidos en caja se mantienen)
            foreach (LineaBoletaViewModel linea in Pendientes) {
                ViewModel.Lineas.Remove(linea);
            }
            Marcadas.Clear();
            Pendientes = pendientes;
            foreach (LineaBoletaViewModel linea in Pendientes) {
                Marcadas.Add(linea);
                ViewModel.Lineas.Add(linea);
            }
            Contexto.NotifyValidationStateChanged();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeCliente = ErrorServicio.Desde(ex);
        } finally {
            Buscando = false;
        }
    }

    private void Marcar(LineaBoletaViewModel linea, bool marcada) {
        if (marcada) {
            Marcadas.Add(linea);
            ViewModel.Lineas.Add(linea);
        } else {
            Marcadas.Remove(linea);
            ViewModel.Lineas.Remove(linea);
        }
    }

    private void AgregarArticulo() {
        ArticuloViewModel? articulo = Articulos.Find(a => a.Id == IdArticuloAgregar);
        if (articulo == null || CantidadAgregar < 1) {
            MensajeArticulo = "Seleccione el artículo e indique una cantidad mayor a 0";
            return;
        }
        // RN-BO-09: lo pedido de un artículo, sumando sus líneas, no supera el stock
        int yaPedido = Vendidos.Where(l => l.IdArticulo == articulo.Id).Sum(l => l.Cantidad);
        if (yaPedido + CantidadAgregar > articulo.StockActual) {
            MensajeArticulo = $"Stock insuficiente de {articulo.Nombre}: quedan {articulo.StockActual - yaPedido}";
            return;
        }
        LineaBoletaViewModel linea = new LineaBoletaViewModel {
            Tipo = "Artículo",
            IdArticulo = articulo.Id,
            Descripcion = articulo.Nombre,
            Cantidad = CantidadAgregar,
            PrecioUnitario = articulo.PrecioBase
        };
        Vendidos.Add(linea);
        ViewModel.Lineas.Add(linea);
        MensajeArticulo = null;
        IdArticuloAgregar = 0;
        CantidadAgregar = 1;
    }

    private void QuitarVenta(LineaBoletaViewModel linea) {
        Vendidos.Remove(linea);
        ViewModel.Lineas.Remove(linea);
    }

    // POST /boletas con detallesServicio (IdDetalleCita) y detallesArticulo (IdArticulo y, si es insumo,
    // IdInsumoUtilizado). El backend asigna el número, fija los precios, recalcula el total y descuenta el stock
    // de lo vendido en caja; si algo no cumple sus reglas se muestra su mensaje.
    private async Task Emitir() {
        if (Guardando || !Contexto.Validate()) {
            return;
        }
        MensajeError = null;
        Guardando = true;
        ViewModel.Fecha = DateTime.Now;
        try {
            await BoletaService.Insert(ViewModel);
            Nav.NavigateTo("/boletas");
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            ViewModel.SerieCorrelativo = NumeroAlEmitir;
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
