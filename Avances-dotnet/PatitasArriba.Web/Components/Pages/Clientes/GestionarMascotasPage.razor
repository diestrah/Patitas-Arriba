@page "/mascotas/nuevo"
@page "/mascotas/editar/{Id:int}"
@attribute [Authorize(Policy = "Mascotas")]
@inject NavigationManager Nav;
@inject IMascotaService MascotaService;
@inject IClienteService ClienteService;

<PageTitle>Mascotas</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nueva mascota" : "Editar mascota")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    @if (Cargando) {
        <p class="text-muted">Cargando mascota...</p>
    } else {
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Dueño</label>
            <PaInputSelect tabindex="1" class="form-select" @bind-Value="ViewModel.IdCliente">
                <option value="0">Seleccione el dueño</option>
                @foreach (ClienteViewModel cliente in Clientes) {
                    <option value="@cliente.Id">@cliente.NombreCompleto (DNI @cliente.Dni)</option>
                }
            </PaInputSelect>
            <ValidationMessage For="() => ViewModel.IdCliente" />
        </div>
        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <PaInputText tabindex="2" class="form-control" @bind-Value="ViewModel.Nombre" />
            <ValidationMessage For="() => ViewModel.Nombre" />
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Tipo</label>
                <PaInputSelect tabindex="3" class="form-select" @bind-Value="ViewModel.TipoMascota">
                    @foreach (TipoMascota tipo in Tipos) {
                        <option value="@tipo">@TextoEnum.De(tipo)</option>
                    }
                </PaInputSelect>
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Raza</label>
                <PaInputText tabindex="4" class="form-control" @bind-Value="ViewModel.Raza" />
                <ValidationMessage For="() => ViewModel.Raza" />
            </div>
            <div class="col-md-4 mb-3">
                <label class="form-label">Sexo</label>
                <PaInputSelect tabindex="5" class="form-select" @bind-Value="ViewModel.Sexo">
                    @foreach (SexoMascota sexo in Sexos) {
                        <option value="@sexo">@TextoEnum.De(sexo)</option>
                    }
                </PaInputSelect>
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Peso (kg)</label>
                <PaInputNumber tabindex="6" class="form-control" @bind-Value="ViewModel.Peso" />
                <ValidationMessage For="() => ViewModel.Peso" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Fecha de nacimiento</label>
                <PaInputDate tabindex="7" class="form-control" @bind-Value="ViewModel.FechaNacimiento" />
                <ValidationMessage For="() => ViewModel.FechaNacimiento" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button tabindex="9" type="submit" class="btn btn-primary btn-texto" disabled="@Guardando"><Icono Nombre="save" /><span>@(Guardando ? "Guardando..." : "Guardar")</span></button>
            <a tabindex="10" class="btn btn-outline-primary" href="mascotas">Cancelar</a>
        </div>
    </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private MascotaViewModel ViewModel { get; set; } = new();
    private List<ClienteViewModel> Clientes { get; set; } = [];
    private TipoMascota[] Tipos { get; } = Enum.GetValues<TipoMascota>();
    private SexoMascota[] Sexos { get; } = Enum.GetValues<SexoMascota>();
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; }

    // GET /clientes para elegir al dueño y, al editar, GET /mascotas/{Id}.
    // Al editar se conservan los datos que este formulario no muestra (la foto que subió el cliente).
    protected override async Task OnParametersSetAsync() {
        MensajeError = null;
        Cargando = true;
        if (!RendererInfo.IsInteractive) return;
        try {
            Clientes = (await ClienteService.FindAll()).OrderBy(c => c.NombreCompleto).ToList();
            if (Id == null) {
                ViewModel = new MascotaViewModel();
                return;
            }
            MascotaViewModel? mascota = await MascotaService.FindById(Id.Value);
            if (mascota == null) {
                Nav.NavigateTo("/mascotas");
                return;
            }
            ViewModel = mascota;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // POST /mascotas o PUT /mascotas/{Id}; si el backend rechaza los datos se muestra su mensaje
    private async Task Guardar() {
        if (Guardando) return;
        MensajeError = null;
        Guardando = true;
        try {
            if (Id == null) {
                await MascotaService.Insert(ViewModel);
            } else {
                await MascotaService.Update(ViewModel);
            }
            Nav.NavigateTo("/mascotas");
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
