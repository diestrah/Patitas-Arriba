@page "/mis-mascotas"
@inject SesionDemo Sesion;

<PageTitle>Mis mascotas</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Mis mascotas</h3>
    <a class="btn btn-warning btn-texto" href="mis-mascotas/nueva">
        <Icono Nombre="plus" /><span>Agregar mascota</span>
    </a>
</div>

@if (Mascotas.Count == 0) {
    <div class="alert alert-info">Aún no tiene mascotas registradas. Agregue la primera para poder reservar una cita.</div>
}

<div class="row g-3">
    @foreach (MascotaViewModel mascota in Mascotas) {
        <div class="col-md-6 col-xl-4">
            <TarjetaMascotaPortal Mascota="mascota" Citas="Citas" />
        </div>
    }
    <div class="col-md-6 col-xl-4">
        <a class="mascota-agregar" href="mis-mascotas/nueva">
            <span class="mascota-agregar-mas">+</span>
            <span>Agregar mascota</span>
        </a>
    </div>
</div>

<p class="text-muted small mt-3">Para dar de baja una mascota, comuníquese con la clínica.</p>

@code {
    // Mascotas y citas del cliente que inició sesión (al enlazar: GET /mascotas?cliente={id} y GET /citas?cliente={id})
    private List<MascotaViewModel> Mascotas { get; set; } = [];
    private List<CitaViewModel> Citas { get; set; } = [];

    protected override void OnInitialized() {
        Mascotas = DatosEjemplo.MascotasDeCliente(Sesion.IdPersona);
        Citas = DatosEjemplo.CitasDeCliente(Sesion.IdPersona);
    }
}
