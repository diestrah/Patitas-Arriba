@page "/clientes/nuevo"
@page "/clientes/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Clientes</PageTitle>

<div class="col-lg-8">
    <h3 class="mb-3">@(Id == null ? "Nuevo cliente" : "Editar cliente")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <CamposCuenta Persona="ViewModel" EsNueva="Id == null" TabIndexInicial="1" />

        <h5 class="mt-2 mb-3">Datos personales</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">DNI</label>
                <PaInputText tabindex="5" class="form-control" maxlength="8" @bind-Value="ViewModel.Dni" />
                <ValidationMessage For="() => ViewModel.Dni" />
            </div>
            <div class="col-md-8 mb-3">
                <label class="form-label">Nombres</label>
                <PaInputText tabindex="6" class="form-control" @bind-Value="ViewModel.Nombres" />
                <ValidationMessage For="() => ViewModel.Nombres" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido paterno</label>
                <PaInputText tabindex="7" class="form-control" @bind-Value="ViewModel.ApellidoPaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoPaterno" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido materno</label>
                <PaInputText tabindex="8" class="form-control" @bind-Value="ViewModel.ApellidoMaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoMaterno" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Teléfono</label>
                <PaInputText tabindex="9" class="form-control" maxlength="9" @bind-Value="ViewModel.Telefono" />
                <ValidationMessage For="() => ViewModel.Telefono" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button tabindex="10" type="submit" class="btn btn-primary btn-texto"><Icono Nombre="save" /><span>Guardar</span></button>
            <a tabindex="11" class="btn btn-outline-primary" href="clientes">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ClienteViewModel ViewModel { get; set; } = new();

    // Mensaje del backend cuando rechace el registro (por ejemplo, DNI o usuario repetido)
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new ClienteViewModel();
            return;
        }
        ClienteViewModel? cliente = DatosEjemplo.Clientes().FirstOrDefault(c => c.Id == Id);
        if (cliente == null) {
            Nav.NavigateTo("/clientes");
            return;
        }
        ViewModel = cliente;
    }

    // Sin backend: no se registra nada, solo se regresa al listado.
    // Al enlazar: registrar = POST /cuentas y luego POST /clientes con esa cuenta (si el segundo falla,
    // se elimina la cuenta recién creada); editar = PUT /cuentas/{IdCuenta} y PUT /clientes/{Id}.
    private void Guardar() {
        Nav.NavigateTo("/clientes");
    }
}
