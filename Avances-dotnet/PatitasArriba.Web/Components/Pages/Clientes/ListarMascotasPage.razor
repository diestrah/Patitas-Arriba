@page "/mascotas"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject IMascotaService MascotaService;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Mascotas</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Mascotas</h3>
    @* El veterinario solo consulta: no ve los botones para registrar, editar ni eliminar *@
    @if (Sesion.EsAdministrador) {
        <button tabindex="4" class="btn btn-warning btn-texto" @onclick="() => NuevaMascota()">
            <Icono Nombre="plus" /><span>Nueva mascota</span>
        </button>
    }
</div>

<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3">
    <label class="text-nowrap">Mascota o dueño:</label>
    <input tabindex="1" class="form-control w-auto flex-grow-1" style="min-width: 14rem" placeholder="Ingrese el nombre de la mascota o del dueño..." @bind="Filtro" />
    <button tabindex="2" class="btn btn-primary btn-texto" @onclick="() => Filtrar()">
        <Icono Nombre="search" /><span>Filtrar</span>
    </button>
    <button tabindex="3" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
    <div class="seg-pago ms-auto" role="group" aria-label="Vista">
        <button type="button" tabindex="4" class="@(Vista == "tarjetas" ? "activo" : "")" aria-pressed="@(Vista == "tarjetas")" @onclick='() => Vista = "tarjetas"'>
            <Icono Nombre="grid" /> Tarjetas
        </button>
        <button type="button" tabindex="5" class="@(Vista == "tabla" ? "activo" : "")" aria-pressed="@(Vista == "tabla")" @onclick='() => Vista = "tabla"'>
            <Icono Nombre="list" /> Tabla
        </button>
    </div>
</div>

<div class="chips-filtro mb-3" role="group" aria-label="Filtrar por tipo">
    @foreach (string tipo in new[] { "Todas", "Perros", "Gatos" }) {
        <button type="button" class="@(TipoFiltro == tipo ? "activo" : "")" aria-pressed="@(TipoFiltro == tipo)" @onclick="() => ElegirTipo(tipo)">
            @tipo <span class="cuenta">@CuantasDe(tipo)</span>
        </button>
    }
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}
@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando mascotas...</p>
}
else if (!Mascotas.Any()) {
    <div class="alert alert-info">No se encontraron mascotas.</div>
}
else if (Vista == "tarjetas") {
    <div class="grilla-tarjetas" style="grid-template-columns: repeat(auto-fill, minmax(280px, 1fr))">
        @foreach (MascotaViewModel mascota in Mascotas) {
            <article class="tarjeta-info">
                <div class="tarjeta-enc">
                    <AvatarMascota Nombre="@mascota.Nombre" Foto="@mascota.Foto" Tamano="grande" />
                    <div>
                        <h5>@mascota.Nombre</h5>
                        <small>@TextoEnum.De(mascota.TipoMascota)@(string.IsNullOrWhiteSpace(mascota.Raza) ? "" : $" · {mascota.Raza}")</small>
                    </div>
                </div>
                <div class="d-flex flex-wrap gap-1">
                    <span class="etq @(mascota.Sexo == SexoMascota.MACHO ? "etq-verde" : "etq-mostaza")">@TextoEnum.De(mascota.Sexo)</span>
                    @if (mascota.FechaNacimiento != null) {
                        <span class="etq etq-gris">@Edad(mascota.FechaNacimiento.Value)</span>
                    }
                    @if (mascota.Peso != null) {
                        <span class="etq etq-gris">@mascota.Peso.Value.ToString("N1") kg</span>
                    }
                </div>
                <div class="datos-contacto">
                    <div><Icono Nombre="user" />@mascota.NombreDueno</div>
                    @if (mascota.FechaNacimiento != null) {
                        <div><Icono Nombre="calendar" />Nació el @mascota.FechaNacimiento.Value.ToString("dd/MM/yyyy")</div>
                    }
                </div>
                <div class="tarjeta-pie">
                    <button class="btn btn-secondary btn-sm btn-texto" @onclick="() => VerHistorial(mascota.Id)">
                        <Icono Nombre="clipboard" /><span>Historial</span>
                    </button>
                    @if (Sesion.EsAdministrador) {
                        <div class="acciones">
                            <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarMascota(mascota.Id)">
                                <Icono Nombre="edit" />
                            </button>
                            <button class="btn btn-outline-danger btn-icono" title="Eliminar" aria-label="Eliminar" @onclick="() => PedirEliminar(mascota)">
                                <Icono Nombre="trash" />
                            </button>
                        </div>
                    }
                </div>
            </article>
        }
    </div>
}
else {
    <QuickGrid Items="Mascotas" Pagination="Paginacion" Class="table table-striped table-hover align-middle">
        <PropertyColumn Title="Nombre" Property="m => m.Nombre" Sortable="true" />
        <PropertyColumn Title="Tipo" Property="m => TextoEnum.De(m.TipoMascota)" />
        <PropertyColumn Title="Raza" Property="m => m.Raza" />
        <PropertyColumn Title="Sexo" Property="m => TextoEnum.De(m.Sexo)" />
        <PropertyColumn Title="Peso (kg)" Property="m => m.Peso" Format="N1" Align="Align.Right" />
        <PropertyColumn Title="Nacimiento" Property="m => m.FechaNacimiento" Format="dd/MM/yyyy" />
        <PropertyColumn Title="Dueño" Property="m => m.NombreDueno" Sortable="true" />
        <TemplateColumn Title="Acciones">
            @* Espacios fijos: historial | editar | eliminar *@
            <div class="acciones-fija">
                <span class="slot-texto">
                    <button class="btn btn-secondary btn-sm btn-texto" @onclick="() => VerHistorial(context.Id)">
                        <Icono Nombre="clipboard" /><span>Historial</span>
                    </button>
                </span>
                @if (Sesion.EsAdministrador) {
                    <span class="slot-icono">
                        <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarMascota(context.Id)">
                            <Icono Nombre="edit" />
                        </button>
                    </span>
                    <span class="slot-icono">
                        <button class="btn btn-outline-danger btn-icono" title="Eliminar" aria-label="Eliminar" @onclick="() => PedirEliminar(context)">
                            <Icono Nombre="trash" />
                        </button>
                    </span>
                }
            </div>
        </TemplateColumn>
    </QuickGrid>
    <Paginador State="Paginacion" />
}

<ConfirmarDialogo Visible="MascotaAEliminar != null"
                  Titulo="¿Eliminar la mascota?"
                  Mensaje="@($"{MascotaAEliminar?.Nombre} ({MascotaAEliminar?.NombreDueno}) dejará de aparecer. No se puede si tiene citas.")"
                  OnConfirmar="EliminarMascota" OnCancelar="CancelarEliminacion" />

@code {
    private List<MascotaViewModel> Todas { get; set; } = [];
    private IQueryable<MascotaViewModel> Mascotas { get; set; } = Enumerable.Empty<MascotaViewModel>().AsQueryable();
    private MascotaViewModel? MascotaAEliminar { get; set; }
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private string Filtro { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 6 };
    private string Vista { get; set; } = "tarjetas";
    private string TipoFiltro { get; set; } = "Todas";

    private bool EsDeTipo(MascotaViewModel m, string tipo) =>
        tipo == "Todas" || (tipo == "Perros" && m.TipoMascota == TipoMascota.PERRO) || (tipo == "Gatos" && m.TipoMascota == TipoMascota.GATO);

    private int CuantasDe(string tipo) => Todas.Count(m => EsDeTipo(m, tipo));

    private void ElegirTipo(string tipo) {
        TipoFiltro = tipo;
        Filtrar();
    }

    // "5 años", "8 meses": para leer la edad de un vistazo
    private static string Edad(DateOnly nacimiento) {
        DateOnly hoy = DateOnly.FromDateTime(DateTime.Today);
        int meses = (hoy.Year - nacimiento.Year) * 12 + hoy.Month - nacimiento.Month - (hoy.Day < nacimiento.Day ? 1 : 0);
        if (meses < 12) return meses <= 1 ? "1 mes" : $"{Math.Max(meses, 0)} meses";
        int años = meses / 12;
        return años == 1 ? "1 año" : $"{años} años";
    }

    // GET /mascotas (cada una trae a su dueño). Solo en la pasada interactiva: así el prerenderizado no repite la consulta
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Todas = await MascotaService.FindAll();
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    private void Filtrar() {
        string texto = Filtro.Trim();
        Mascotas = Todas
            .Where(m => EsDeTipo(m, TipoFiltro)
                     && (m.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || m.NombreDueno.Contains(texto, StringComparison.OrdinalIgnoreCase)))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        Filtrar();
    }

    private void NuevaMascota() {
        Nav.NavigateTo("/mascotas/nuevo");
    }

    private void EditarMascota(int id) {
        Nav.NavigateTo($"/mascotas/editar/{id}");
    }

    private void VerHistorial(int id) {
        Nav.NavigateTo($"/reportes/historial-clinico/{id}");
    }

    private void PedirEliminar(MascotaViewModel mascota) {
        MascotaAEliminar = mascota;
    }

    private void CancelarEliminacion() {
        MascotaAEliminar = null;
    }

    // DELETE /mascotas/{id}; si el backend lo rechaza (RN-MA-05: tiene citas) se muestra su mensaje
    private async Task EliminarMascota() {
        if (MascotaAEliminar == null) {
            return;
        }
        MascotaViewModel mascota = MascotaAEliminar;
        MascotaAEliminar = null;
        MensajeExito = null;
        MensajeError = null;
        try {
            await MascotaService.Delete(mascota.Id);
            Todas.Remove(mascota);
            MensajeExito = $"Se eliminó la mascota {mascota.Nombre}.";
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
    }
}
