@page "/veterinarios/nuevo"
@page "/veterinarios/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Veterinarios</PageTitle>

<div class="col-lg-8">
    <h3 class="mb-3">@(Id == null ? "Nuevo veterinario" : "Editar veterinario")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <CamposCuenta Persona="ViewModel" EsNueva="Id == null" TabIndexInicial="1" />

        <h5 class="mt-2 mb-3">Datos personales</h5>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">DNI</label>
                <PaInputText tabindex="5" class="form-control" maxlength="8" @bind-Value="ViewModel.Dni" />
                <ValidationMessage For="() => ViewModel.Dni" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">N.° de colegiatura</label>
                <PaInputText tabindex="6" class="form-control" @bind-Value="ViewModel.NumeroColegiatura" />
                <ValidationMessage For="() => ViewModel.NumeroColegiatura" />
            </div>
        </div>
        <div class="mb-3">
            <label class="form-label">Nombres</label>
            <PaInputText tabindex="7" class="form-control" @bind-Value="ViewModel.Nombres" />
            <ValidationMessage For="() => ViewModel.Nombres" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido paterno</label>
                <PaInputText tabindex="8" class="form-control" @bind-Value="ViewModel.ApellidoPaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoPaterno" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido materno</label>
                <PaInputText tabindex="9" class="form-control" @bind-Value="ViewModel.ApellidoMaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoMaterno" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Teléfono</label>
                <PaInputText tabindex="10" class="form-control" maxlength="9" @bind-Value="ViewModel.Telefono" />
                <ValidationMessage For="() => ViewModel.Telefono" />
            </div>
        </div>

        <h5 class="mt-2 mb-1">Horarios de atención</h5>
        <div class="form-text mt-0 mb-2">Solo recibe citas en los horarios marcados.</div>
        <div class="row mb-3">
            @foreach (OpcionSeleccion horario in ViewModel.Horarios) {
                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="@($"horario-{horario.Id}")" @bind-Value="horario.Seleccionado" />
                        <label class="form-check-label" for="@($"horario-{horario.Id}")">@horario.Texto</label>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <button tabindex="11" type="submit" class="btn btn-primary btn-texto"><Icono Nombre="save" /><span>Guardar</span></button>
            <a tabindex="12" class="btn btn-outline-primary" href="veterinarios">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private VeterinarioViewModel ViewModel { get; set; } = new();

    // Mensaje del backend cuando rechace el registro (por ejemplo, DNI o colegiatura repetidos)
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new VeterinarioViewModel { Horarios = DatosEjemplo.OpcionesHorario() };
            return;
        }
        VeterinarioViewModel? veterinario = DatosEjemplo.Veterinarios().FirstOrDefault(v => v.Id == Id);
        if (veterinario == null) {
            Nav.NavigateTo("/veterinarios");
            return;
        }
        ViewModel = veterinario;
    }

    // Sin backend: no se registra nada, solo se regresa al listado.
    // Al enlazar: POST /cuentas y luego POST /veterinarios (con la cuenta y los horarios marcados);
    // al editar: PUT /cuentas/{IdCuenta} y PUT /veterinarios/{Id}.
    private void Guardar() {
        Nav.NavigateTo("/veterinarios");
    }
}
