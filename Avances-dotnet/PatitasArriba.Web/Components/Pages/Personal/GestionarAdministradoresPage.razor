@page "/administradores/nuevo"
@page "/administradores/editar/{Id:int}"
@attribute [Authorize(Policy = "Personal")]
@inject NavigationManager Nav;
@inject IAdministradorService AdministradorService;
@inject IHorarioService HorarioService;

<PageTitle>Administradores</PageTitle>

<div class="col-lg-8">
    <h3 class="mb-3">@(Id == null ? "Nuevo administrador" : "Editar administrador")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    @if (Cargando) {
        <p class="text-muted">Cargando administrador...</p>
    } else {
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <CamposCuenta Persona="ViewModel" EsNueva="Id == null" TabIndexInicial="1" />

        <h5 class="mt-2 mb-3">Datos personales</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">DNI</label>
                <PaInputText tabindex="5" class="form-control" maxlength="8" @bind-Value="ViewModel.Dni" />
                <ValidationMessage For="() => ViewModel.Dni" />
            </div>
            <div class="col-md-8 mb-3">
                <label class="form-label">Nombres</label>
                <PaInputText tabindex="6" class="form-control" @bind-Value="ViewModel.Nombres" />
                <ValidationMessage For="() => ViewModel.Nombres" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido paterno</label>
                <PaInputText tabindex="7" class="form-control" @bind-Value="ViewModel.ApellidoPaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoPaterno" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido materno</label>
                <PaInputText tabindex="8" class="form-control" @bind-Value="ViewModel.ApellidoMaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoMaterno" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Teléfono</label>
                <PaInputText tabindex="9" class="form-control" maxlength="9" @bind-Value="ViewModel.Telefono" />
                <ValidationMessage For="() => ViewModel.Telefono" />
            </div>
        </div>

        <h5 class="mt-2 mb-1">Horarios de atención</h5>
        <div class="form-text mt-0 mb-2">Turnos en los que trabaja en la clínica.</div>
        <div class="row mb-3">
            @foreach (OpcionSeleccion horario in ViewModel.Horarios) {
                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="@($"horario-{horario.Id}")" @bind-Value="horario.Seleccionado" />
                        <label class="form-check-label" for="@($"horario-{horario.Id}")">@horario.Texto</label>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <button tabindex="10" type="submit" class="btn btn-primary btn-texto" disabled="@Guardando"><Icono Nombre="save" /><span>@(Guardando ? "Guardando..." : "Guardar")</span></button>
            <a tabindex="11" class="btn btn-outline-primary" href="administradores">Cancelar</a>
        </div>
    </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private AdministradorViewModel ViewModel { get; set; } = new();

    // Mensaje del backend cuando rechace el registro (por ejemplo, DNI o correo repetido)
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; }

    // GET /horarios para las casillas y, al editar, GET /administradores/{Id}
    protected override async Task OnParametersSetAsync() {
        MensajeError = null;
        Cargando = true;
        if (!RendererInfo.IsInteractive) return;
        try {
            List<HorarioViewModel> horarios = await HorarioService.FindAll();
            AdministradorViewModel administrador;
            if (Id == null) {
                administrador = new AdministradorViewModel();
            } else {
                AdministradorViewModel? encontrado = await AdministradorService.FindById(Id.Value);
                if (encontrado == null) {
                    Nav.NavigateTo("/administradores");
                    return;
                }
                administrador = encontrado;
            }
            administrador.Horarios = PersonalClinica.OpcionesHorario(horarios, administrador.Horarios);
            ViewModel = administrador;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // Nuevo: POST /administradores/con-cuenta (crea la persona y su cuenta con solo el correo; la persona
    // recibe un enlace para elegir su contraseña). Editar: PUT /administradores/{Id} con los horarios marcados.
    private async Task Guardar() {
        if (Guardando) return;
        MensajeError = null;
        Guardando = true;
        try {
            if (Id == null) {
                await AdministradorService.Insert(ViewModel);
            } else {
                await AdministradorService.Update(ViewModel);
            }
            Nav.NavigateTo("/administradores");
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
