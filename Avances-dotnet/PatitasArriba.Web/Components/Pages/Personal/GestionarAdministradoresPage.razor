@page "/administradores/nuevo"
@page "/administradores/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Administradores</PageTitle>

<div class="col-lg-8">
    <h3 class="mb-3">@(Id == null ? "Nuevo administrador" : "Editar administrador")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <CamposCuenta Persona="ViewModel" EsNueva="Id == null" TabIndexInicial="1" />

        <h5 class="mt-2 mb-3">Datos personales</h5>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">DNI</label>
                <InputText tabindex="5" class="form-control" maxlength="8" @bind-Value="ViewModel.Dni" />
                <ValidationMessage For="() => ViewModel.Dni" />
            </div>
            <div class="col-md-8 mb-3">
                <label class="form-label">Nombres</label>
                <InputText tabindex="6" class="form-control" @bind-Value="ViewModel.Nombres" />
                <ValidationMessage For="() => ViewModel.Nombres" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido paterno</label>
                <InputText tabindex="7" class="form-control" @bind-Value="ViewModel.ApellidoPaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoPaterno" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Apellido materno</label>
                <InputText tabindex="8" class="form-control" @bind-Value="ViewModel.ApellidoMaterno" />
                <ValidationMessage For="() => ViewModel.ApellidoMaterno" />
            </div>
        </div>
        <div class="row">
            <div class="col-md-4 mb-3">
                <label class="form-label">Teléfono</label>
                <InputText tabindex="9" class="form-control" maxlength="9" @bind-Value="ViewModel.Telefono" />
                <ValidationMessage For="() => ViewModel.Telefono" />
            </div>
        </div>

        <h5 class="mt-2 mb-1">Horarios de atención</h5>
        <div class="form-text mt-0 mb-2">Turnos en los que trabaja en la clínica.</div>
        <div class="row mb-3">
            @foreach (OpcionSeleccion horario in ViewModel.Horarios) {
                <div class="col-md-6">
                    <div class="form-check">
                        <InputCheckbox class="form-check-input" id="@($"horario-{horario.Id}")" @bind-Value="horario.Seleccionado" />
                        <label class="form-check-label" for="@($"horario-{horario.Id}")">@horario.Texto</label>
                    </div>
                </div>
            }
        </div>

        <div class="d-flex gap-2">
            <button tabindex="10" type="submit" class="btn btn-primary btn-texto"><Icono Nombre="save" /><span>Guardar</span></button>
            <a tabindex="11" class="btn btn-outline-primary" href="administradores">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private AdministradorViewModel ViewModel { get; set; } = new();

    // Mensaje del backend cuando rechace el registro (por ejemplo, DNI o usuario repetido)
    private string? MensajeError { get; set; }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new AdministradorViewModel { Horarios = DatosEjemplo.OpcionesHorario() };
            return;
        }
        AdministradorViewModel? administrador = DatosEjemplo.Administradores().FirstOrDefault(a => a.Id == Id);
        if (administrador == null) {
            Nav.NavigateTo("/administradores");
            return;
        }
        ViewModel = administrador;
    }

    // Sin backend: no se registra nada, solo se regresa al listado.
    // Al enlazar: POST /cuentas y luego POST /administradores (con la cuenta y los horarios marcados);
    // al editar: PUT /cuentas/{IdCuenta} y PUT /administradores/{Id}.
    private void Guardar() {
        Nav.NavigateTo("/administradores");
    }
}
