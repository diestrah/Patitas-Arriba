@page "/administradores"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject IHorarioService HorarioService;
@inject IVeterinarioService VeterinarioService;
@inject IAdministradorService AdministradorService;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Administradores</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Administradores</h3>
    <button tabindex="6" class="btn btn-warning btn-texto" @onclick="() => NuevoAdministrador()">
        <Icono Nombre="plus" /><span>Nuevo administrador</span>
    </button>
</div>

<div class="row g-3 mb-3">
    <div class="col-sm-6 col-xl-3">
        <div class="indicador indicador-verde">
            <span class="indicador-icono"><Icono Nombre="users" /></span>
            <span class="indicador-valor">@Todos.Count</span>
            <span class="indicador-texto">Administradores activos</span>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="indicador indicador-mostaza">
            <span class="indicador-icono"><Icono Nombre="clock" /></span>
            <span class="indicador-valor">@(EnTurno.Count == 0 ? "Ninguno" : $"{EnTurno.Count} en turno")</span>
            <span class="indicador-texto">@(EnTurno.Count == 0 ? "Fuera de los horarios asignados" : string.Join(", ", EnTurno.Select(a => a.Nombres.Split(' ')[0])))</span>
        </div>
    </div>
</div>

<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3">
    <label class="text-nowrap" for="filtro-adm">DNI o nombre:</label>
    <input id="filtro-adm" tabindex="1" class="form-control w-auto flex-grow-1" style="min-width: 14rem" placeholder="Ingrese el DNI o el nombre..." @bind="Filtro" />
    <button tabindex="2" class="btn btn-primary btn-texto" @onclick="() => Filtrar()">
        <Icono Nombre="search" /><span>Filtrar</span>
    </button>
    <button tabindex="3" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
    <div class="seg-pago ms-auto" role="group" aria-label="Vista">
        <button type="button" tabindex="4" class="@(Vista == "tarjetas" ? "activo" : "")" aria-pressed="@(Vista == "tarjetas")" @onclick='() => Vista = "tarjetas"'>
            <Icono Nombre="grid" /> Tarjetas
        </button>
        <button type="button" tabindex="5" class="@(Vista == "tabla" ? "activo" : "")" aria-pressed="@(Vista == "tabla")" @onclick='() => Vista = "tabla"'>
            <Icono Nombre="list" /> Tabla
        </button>
    </div>
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}
@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando administradores...</p>
}
else if (!Filtrados.Any()) {
    <div class="alert alert-info">No se encontraron administradores.</div>
}
else if (Vista == "tarjetas") {
    <div class="row g-3">
        @foreach (AdministradorViewModel administrador in Filtrados) {
            <div class="col-md-6 col-xl-4">
                <TarjetaPersonal Persona="administrador" Propia="EsLaSesion(administrador)" MotivoBloqueo="@MotivoBloqueo(administrador)"
                                 HorariosAsignados="Personal.HorariosDe(administrador)"
                                 OnEditar="p => EditarAdministrador(p.Id)" OnEliminar="p => PedirEliminar((AdministradorViewModel)p)" />
            </div>
        }
    </div>
}
else {
    <QuickGrid Items="Administradores" Pagination="Paginacion" Class="table table-striped table-hover align-middle">
        <PropertyColumn Title="DNI" Property="a => a.Dni" Sortable="true" />
        <TemplateColumn Title="Nombre completo" SortBy="PorNombre">
            @context.NombreCompleto
            @if (EsLaSesion(context)) {
                <span class="estado estado-pendiente mini ms-1">tú</span>
            }
        </TemplateColumn>
        <PropertyColumn Title="Teléfono" Property="a => a.Telefono" />
        <PropertyColumn Title="Horarios" Property="a => a.TextoHorarios" />
        <TemplateColumn Title="Acciones" Align="Align.Center">
            <div class="acciones">
                <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarAdministrador(context.Id)">
                    <Icono Nombre="edit" />
                </button>
                @if (MotivoBloqueo(context) != null) {
                    <span class="btn-icono-bloqueado" tabindex="0" title="@MotivoBloqueo(context)" aria-label="@($"Eliminar no disponible: {MotivoBloqueo(context)}")">
                        <Icono Nombre="lock" />
                    </span>
                } else {
                    <button class="btn btn-outline-danger btn-icono" title="Eliminar" aria-label="Eliminar" @onclick="() => PedirEliminar(context)">
                        <Icono Nombre="trash" />
                    </button>
                }
            </div>
        </TemplateColumn>
    </QuickGrid>
    <Paginador State="Paginacion" />
}

<ConfirmarDialogo Visible="AdministradorAEliminar != null"
                  Titulo="¿Eliminar al administrador?"
                  Mensaje="@($"{AdministradorAEliminar?.NombreCompleto} y su cuenta de usuario se darán de baja.")"
                  OnConfirmar="EliminarAdministrador" OnCancelar="CancelarEliminacion" />

@code {
    private List<AdministradorViewModel> Todos { get; set; } = [];
    private IQueryable<AdministradorViewModel> Administradores { get; set; } = Enumerable.Empty<AdministradorViewModel>().AsQueryable();
    private AdministradorViewModel? AdministradorAEliminar { get; set; }
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private string Filtro { get; set; } = string.Empty;
    private string Vista { get; set; } = "tarjetas";
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 5 };
    private GridSort<AdministradorViewModel> PorNombre { get; } = GridSort<AdministradorViewModel>.ByAscending(a => a.NombreCompleto);

    private bool Cargando { get; set; } = true;
    private PersonalClinica Personal { get; set; } = new();

    private List<AdministradorViewModel> Filtrados => Administradores.ToList();
    private List<AdministradorViewModel> EnTurno => Todos.Where(a => TurnosPersonal.EnTurno(Personal.HorariosDe(a), DateTime.Now) != null).ToList();

    // GET /horarios, /veterinarios y /administradores (cada persona trae los ids de sus horarios)
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Personal = await PersonalClinica.Cargar(HorarioService, VeterinarioService, AdministradorService);
            Todos = Personal.Administradores;
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // Fila del administrador que inició sesión
    private bool EsLaSesion(AdministradorViewModel administrador) {
        return Sesion.EsAdministrador && administrador.Id == Sesion.IdPersona;
    }

    // Por qué no se puede eliminar (null si se puede): no a sí mismo y nunca al último administrador
    private string? MotivoBloqueo(AdministradorViewModel administrador) {
        if (EsLaSesion(administrador)) {
            return "No puede eliminarse a sí mismo mientras está en sesión";
        }
        return Todos.Count == 1 ? "Siempre debe existir al menos un administrador (RN-AD-02)" : null;
    }

    private void Filtrar() {
        string texto = Filtro.Trim();
        Administradores = Todos
            .Where(a => a.Dni.Contains(texto) || a.NombreCompleto.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        Filtrar();
    }

    private void NuevoAdministrador() {
        Nav.NavigateTo("/administradores/nuevo");
    }

    private void EditarAdministrador(int id) {
        Nav.NavigateTo($"/administradores/editar/{id}");
    }

    private void PedirEliminar(AdministradorViewModel administrador) {
        AdministradorAEliminar = administrador;
    }

    private void CancelarEliminacion() {
        AdministradorAEliminar = null;
    }

    // DELETE /administradores/{id} (también da de baja su cuenta). El backend no deja eliminar al último
    // administrador activo (RN-AD-02): en ese caso se muestra su mensaje
    private async Task EliminarAdministrador() {
        if (AdministradorAEliminar == null) {
            return;
        }
        AdministradorViewModel administrador = AdministradorAEliminar;
        AdministradorAEliminar = null;
        MensajeExito = null;
        MensajeError = null;
        try {
            await AdministradorService.Delete(administrador.Id);
            Todos.Remove(administrador);
            MensajeExito = $"Se eliminó al administrador {administrador.NombreCompleto}.";
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
    }
}
