@page "/cuentas-usuario"
@attribute [Authorize(Policy = "CuentasUsuario")]
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject ICuentaService CuentaService;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Cuentas de usuario</PageTitle>

<h3 class="mb-1">Cuentas de usuario</h3>
<p class="text-muted small mb-3">Las cuentas se crean al registrar un cliente, un veterinario o un administrador.</p>

<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3">
    <label class="text-nowrap">Usuario o correo:</label>
    <input tabindex="1" class="form-control w-auto flex-grow-1" style="min-width: 14rem" placeholder="Ingrese el usuario o el correo..." @bind="Filtro" />
    <button tabindex="2" class="btn btn-primary btn-texto" @onclick="() => Filtrar()">
        <Icono Nombre="search" /><span>Filtrar</span>
    </button>
    <button tabindex="3" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
</div>

<div class="chips-filtro mb-3" role="group" aria-label="Filtrar por rol">
    @foreach (string rol in Roles) {
        <button type="button" class="@(RolFiltro == rol ? "activo" : "")" aria-pressed="@(RolFiltro == rol)" @onclick="() => ElegirRol(rol)">
            @rol <span class="cuenta">@CuantasDe(rol)</span>
        </button>
    }
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}
@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando cuentas...</p>
}
else if (!Cuentas.Any()) {
    <div class="alert alert-info">No se encontraron cuentas.</div>
}
else {
    <div class="lista-cuentas">
        <div class="fila-cuenta cabecera"><span></span><span>Usuario</span><span>Pertenece a</span><span>Rol</span><span>Acciones</span></div>
        @foreach (CuentaUsuarioViewModel cuenta in Cuentas.OrderBy(c => c.NombreUsuario)) {
            <div class="fila-cuenta">
                <span class="avatar-persona @Presentacion.ColorAvatar(NombreVisible(cuenta))" aria-hidden="true">@Presentacion.Iniciales(NombreVisible(cuenta))</span>
                <div>
                    <b>@cuenta.NombreUsuario @if (EsLaSesion(cuenta)) { <span class="etq etq-verde ms-1">tú</span> }</b>
                    <span class="correo">@cuenta.Correo</span>
                </div>
                <div class="text-muted">@cuenta.NombrePersona</div>
                <span class="etq @ClaseRol(cuenta.Rol)" style="justify-self: start">@TextoEnum.De(cuenta.Rol)</span>
                <div class="acciones">
                    <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarCuenta(cuenta.Id)">
                        <Icono Nombre="edit" />
                    </button>
                    @if (EsLaSesion(cuenta)) {
                        <span class="btn-icono-bloqueado" tabindex="0" title="No puede eliminar su propia cuenta mientras está en sesión" aria-label="Eliminar no disponible: es su propia cuenta">
                            <Icono Nombre="lock" />
                        </span>
                    } else {
                        <button class="btn btn-outline-danger btn-icono" title="Eliminar" aria-label="Eliminar" @onclick="() => PedirEliminar(cuenta)">
                            <Icono Nombre="trash" />
                        </button>
                    }
                </div>
            </div>
        }
    </div>
}

<ConfirmarDialogo Visible="CuentaAEliminar != null"
                  Titulo="¿Eliminar la cuenta?"
                  Mensaje="@($"La cuenta “{CuentaAEliminar?.NombreUsuario}” ya no podrá iniciar sesión.")"
                  OnConfirmar="EliminarCuenta" OnCancelar="CancelarEliminacion" />

@code {
    private List<CuentaUsuarioViewModel> Todas { get; set; } = [];
    private IQueryable<CuentaUsuarioViewModel> Cuentas { get; set; } = Enumerable.Empty<CuentaUsuarioViewModel>().AsQueryable();
    private CuentaUsuarioViewModel? CuentaAEliminar { get; set; }
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private string Filtro { get; set; } = string.Empty;
    private static readonly string[] Roles = ["Todos", "Administradores", "Veterinarios", "Clientes"];
    private string RolFiltro { get; set; } = "Todos";

    private bool EsDeRol(CuentaUsuarioViewModel c, string rol) => rol switch {
        "Administradores" => c.Rol == RolUsuario.ADMINISTRADOR,
        "Veterinarios" => c.Rol == RolUsuario.VETERINARIO,
        "Clientes" => c.Rol == RolUsuario.CLIENTE,
        _ => true
    };

    private int CuantasDe(string rol) => Todas.Count(c => EsDeRol(c, rol));

    private void ElegirRol(string rol) {
        RolFiltro = rol;
        Filtrar();
    }

    private static string NombreVisible(CuentaUsuarioViewModel c) => string.IsNullOrWhiteSpace(c.NombrePersona) ? c.NombreUsuario : c.NombrePersona;

    private static string ClaseRol(RolUsuario? rol) => rol switch {
        RolUsuario.ADMINISTRADOR => "etq-mostaza",
        RolUsuario.VETERINARIO => "etq-verde",
        _ => "etq-gris"
    };

    private bool Cargando { get; set; } = true;

    // GET /cuentas. El servicio también consulta /clientes, /veterinarios y /administradores
    // para saber a quién pertenece cada cuenta y su rol
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Todas = await CuentaService.FindAll();
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // Cuenta con la que se inició sesión
    private bool EsLaSesion(CuentaUsuarioViewModel cuenta) {
        return cuenta.Id == Sesion.IdCuenta;
    }

    private void Filtrar() {
        string texto = Filtro.Trim();
        Cuentas = Todas
            .Where(c => EsDeRol(c, RolFiltro)
                     && (c.NombreUsuario.Contains(texto, StringComparison.OrdinalIgnoreCase)
                         || c.Correo.Contains(texto, StringComparison.OrdinalIgnoreCase)))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        Filtrar();
    }

    private void EditarCuenta(int id) {
        Nav.NavigateTo($"/cuentas-usuario/editar/{id}");
    }

    private void PedirEliminar(CuentaUsuarioViewModel cuenta) {
        CuentaAEliminar = cuenta;
    }

    private void CancelarEliminacion() {
        CuentaAEliminar = null;
    }

    // DELETE /cuentas/{id}. El backend no deja dar de baja una cuenta que usa una persona activa (RN-CU-06):
    // la cuenta se da de baja junto con la persona. En ese caso se muestra su mensaje.
    private async Task EliminarCuenta() {
        if (CuentaAEliminar == null) {
            return;
        }
        CuentaUsuarioViewModel cuenta = CuentaAEliminar;
        CuentaAEliminar = null;
        MensajeExito = null;
        MensajeError = null;
        try {
            await CuentaService.Delete(cuenta.Id);
            Todas.Remove(cuenta);
            MensajeExito = $"Se eliminó la cuenta “{cuenta.NombreUsuario}”.";
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
    }
}
