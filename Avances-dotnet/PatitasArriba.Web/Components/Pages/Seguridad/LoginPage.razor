@page "/login"
@layout LayoutVacio
@implements IAsyncDisposable
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject IJSRuntime JS;

<PageTitle>Iniciar sesión · Patitas Arriba</PageTitle>

<div class="login-page">
    @* La sala con los perritos la dibuja wwwroot/js/login-patitas.js dentro del <svg id="sala"> *@
    <section class="stage-panel" id="stage" data-state="idle" aria-hidden="true">
        <svg class="sala" id="sala" viewBox="0 0 1200 1000" preserveAspectRatio="xMidYMax meet" xmlns="http://www.w3.org/2000/svg"></svg>
        <div class="marca">
            <div class="logo">
                <svg viewBox="0 0 64 64" width="28" height="28" fill="#fff">
                    <ellipse cx="32" cy="42" rx="14" ry="12" />
                    <ellipse cx="14" cy="26" rx="6" ry="8" transform="rotate(-18 14 26)" />
                    <ellipse cx="25" cy="14" rx="6" ry="8" transform="rotate(-6 25 14)" />
                    <ellipse cx="39" cy="14" rx="6" ry="8" transform="rotate(6 39 14)" />
                    <ellipse cx="50" cy="26" rx="6" ry="8" transform="rotate(18 50 26)" />
                </svg>
            </div>
            <h1>Patitas Arriba<small>Clínica y estética veterinaria</small></h1>
        </div>
    </section>

    <section class="form-panel">
        <div class="login-contenedor">
            <EditForm EditContext="Contexto" OnValidSubmit="Ingresar" class="login-tarjeta">
                <DataAnnotationsValidator />

                <h2>¡Hola de nuevo!</h2>
                <p class="sub">Ingresa con tu correo y tu contraseña.</p>

                @if (MensajeError != null) {
                    <div class="login-error">@MensajeError</div>
                }

                <div class="campo">
                    <label for="correo">Correo electrónico</label>
                    <div class="input-wrap">
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3 7 9 6 9-6" /></svg>
                        <InputText id="correo" tabindex="1" class="login-input" placeholder="nombre@correo.com" autocomplete="username" inputmode="email" @bind-Value="ViewModel.Correo" @onblur="() => Tocar(nameof(LoginViewModel.Correo))" />
                    </div>
                    <ValidationMessage For="() => ViewModel.Correo" />
                </div>

                <div class="campo">
                    <label for="clave">Contraseña</label>
                    <div class="input-wrap">
                        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="11" width="16" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" /></svg>
                        <InputText id="clave" tabindex="2" type="password" class="login-input" placeholder="••••••••" autocomplete="current-password" @bind-Value="ViewModel.Password" @onblur="() => Tocar(nameof(LoginViewModel.Password))" />
                        @* Mostrar u ocultar la contraseña lo maneja login-patitas.js (los perritos espían con un ojo) *@
                        <button class="eye-btn" type="button" id="ver" aria-label="Mostrar contraseña" title="Mostrar contraseña">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" /><circle cx="12" cy="12" r="3" /></svg>
                        </button>
                    </div>
                    <ValidationMessage For="() => ViewModel.Password" />
                </div>

                <a class="olvide" href="olvide-contrasena" tabindex="4">¿Olvidaste tu contraseña?</a>

                <button class="login-boton" type="submit" tabindex="3" disabled="@Enviando">
                    @(Enviando ? "Ingresando..." : "Ingresar")
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
                </button>

                <p class="login-registro">¿No tienes una cuenta? <a href="registro" tabindex="5">Crea una</a></p>

                <div class="login-ayuda">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10" /><path d="M12 16v-4M12 8h.01" /></svg>
                    <span>No eliges tu rol: el sistema lo detecta según tu cuenta.</span>
                </div>


                @* Cuentas de Avances/sql/datos-prueba.sql (contraseña Patitas123): solo existen si se cargó ese script *@
                <div class="login-demo">
                    Cuentas de prueba (contraseña Patitas123):
                    <div class="chips">
                        <button type="button" class="chip" @onclick='() => Rellenar("rosa.admin@patitas.pe")'><b>rosa.admin@patitas.pe</b> · Administradora</button>
                        <button type="button" class="chip" @onclick='() => Rellenar("dra.lucia@patitas.pe")'><b>dra.lucia@patitas.pe</b> · Veterinaria</button>
                        <button type="button" class="chip" @onclick='() => Rellenar("ana.torres@gmail.com")'><b>ana.torres@gmail.com</b> · Cliente</button>
                    </div>
                </div>
            </EditForm>
            @* Validado el formulario, login-patitas.js (enviarLogin) copia los datos aquí y lo envía a POST /cuenta/login,
               que crea la cookie de sesión (Seguridad/SeguridadExtensions.cs) *@
            <form id="form-sesion" method="post" action="cuenta/login" hidden>
                <AntiforgeryToken />
                <input type="hidden" name="correo" />
                <input type="hidden" name="password" />
            </form>
            <p class="lema">Cuidamos a tu mejor amigo con mucho cariño <span>♥</span></p>
        </div>
    </section>
</div>

@code {
    private LoginViewModel ViewModel { get; set; } = new();
    private EditContext Contexto { get; set; } = default!;
    private string? MensajeError { get; set; }
    private bool Enviando { get; set; }

    // POST /cuenta/login vuelve aquí con ?error=credenciales o ?error=conexion si no pudo iniciar sesión
    [SupplyParameterFromQuery(Name = "error")]
    private string? Error { get; set; }

    protected override void OnInitialized() {
        Contexto = new EditContext(ViewModel);
        if (Sesion.HaIniciadoSesion) {
            Nav.NavigateTo("/", replace: true);
            return;
        }
        // Si las credenciales fallan el mensaje es siempre el mismo, sin decir si falló el correo o la contraseña (RN-CU-05)
        MensajeError = Error switch {
            "credenciales" => "Correo o contraseña incorrectos",
            "conexion" => ErrorServicio.SinConexion,
            _ => null
        };
    }

    // Al salir de un campo se valida, aunque no se haya escrito nada
    private void Tocar(string campo) {
        Contexto.NotifyFieldChanged(new FieldIdentifier(ViewModel, campo));
    }

    protected override async Task OnAfterRenderAsync(bool firstRender) {
        if (firstRender) {
            try {
                await JS.InvokeVoidAsync("iniciarSalaLogin");
            } catch (JSException) {
                // Si la animación falla, el formulario sigue funcionando
            }
        }
    }

    private void Rellenar(string correo) {
        ViewModel.Correo = correo;
        ViewModel.Password = "Patitas123";
        MensajeError = null;
    }

    // POST /cuenta/login: el backend valida la contraseña y deduce el rol de la cuenta; si sale bien
    // se guarda la cookie y se va al inicio, si no se vuelve aquí con ?error=...
    private async Task Ingresar() {
        if (Enviando) return;
        MensajeError = null;
        Enviando = true;
        try {
            await JS.InvokeVoidAsync("enviarLogin", ViewModel.Correo.Trim(), ViewModel.Password);
        } catch (JSException) {
            Enviando = false;
            MensajeError = ErrorServicio.SinConexion;
        }
    }

    public async ValueTask DisposeAsync() {
        try {
            await JS.InvokeVoidAsync("detenerSalaLogin");
        } catch (JSDisconnectedException) {
        } catch (InvalidOperationException) {
        } catch (JSException) {
        }
    }
}
