@page "/verificar-correo"
@layout LayoutVacio
@inject IAccesoService AccesoService

<PageTitle>Verificar correo · Patitas Arriba</PageTitle>

@* Es la página a la que lleva el enlace del correo de registro: /verificar-correo?token=... *@
<AccesoMarco Titulo="@Titulo" Subtitulo="@(Estado == EstadoVerificacion.Activa ? "Confirmamos tu correo. Ya puedes iniciar sesión." : null)">
    @switch (Estado) {
        case EstadoVerificacion.Verificando:
            <div class="aviso-ok">Estamos confirmando tu correo...</div>
            break;
        case EstadoVerificacion.Activa:
            <a class="login-boton" href="login">Iniciar sesión</a>
            break;
        default:
            <div class="login-error">@MensajeError</div>
            <a class="login-boton" href="registro">Volver a registrarme</a>
            break;
    }
</AccesoMarco>

@code {
    [SupplyParameterFromQuery]
    public string? Token { get; set; }

    private enum EstadoVerificacion { Verificando, Activa, Error }

    private EstadoVerificacion Estado { get; set; } = EstadoVerificacion.Verificando;
    private string MensajeError { get; set; } = "El enlace no es válido o ya venció.";

    private string Titulo => Estado switch {
        EstadoVerificacion.Verificando => "Verificando tu correo",
        EstadoVerificacion.Activa => "¡Tu cuenta quedó activa!",
        _ => "No pudimos activar tu cuenta"
    };

    // POST /acceso/registro/confirmar con { token }. El token es de un solo uso: con el prerenderizado de
    // Blazor este método corre dos veces (primero en el servidor y luego en el circuito interactivo),
    // por eso se confirma solo en la pasada interactiva; si no, la segunda llamada vería el token ya usado.
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        if (string.IsNullOrWhiteSpace(Token)) {
            Estado = EstadoVerificacion.Error;
            return;
        }
        try {
            await AccesoService.ConfirmarRegistro(Token);
            Estado = EstadoVerificacion.Activa;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
            Estado = EstadoVerificacion.Error;
        }
    }
}
