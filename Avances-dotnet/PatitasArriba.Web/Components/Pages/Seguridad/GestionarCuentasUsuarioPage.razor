@page "/cuentas-usuario/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Cuentas de usuario</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">Editar cuenta de usuario</h3>

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Pertenece a</label>
            <input class="form-control" value="@($"{ViewModel.NombrePersona} ({TextoEnum.De(ViewModel.Rol)})")" disabled />
        </div>
        <div class="mb-3">
            <label class="form-label">Nombre de usuario</label>
            <InputText tabindex="1" class="form-control" @bind-Value="ViewModel.NombreUsuario" />
            <ValidationMessage For="() => ViewModel.NombreUsuario" />
        </div>
        <div class="mb-3">
            <label class="form-label">Correo electrónico</label>
            <InputText tabindex="2" type="email" class="form-control" @bind-Value="ViewModel.Correo" />
            <ValidationMessage For="() => ViewModel.Correo" />
        </div>
        <div class="mb-3">
            <label class="form-label">Nueva contraseña</label>
            <InputText tabindex="3" type="password" class="form-control" autocomplete="new-password" @bind-Value="ViewModel.Password" />
            <div class="form-text">Déjela vacía para mantener la contraseña actual.</div>
            <ValidationMessage For="() => ViewModel.Password" />
        </div>

        <div class="d-flex gap-2">
            <button tabindex="4" type="submit" class="btn btn-primary btn-texto"><Icono Nombre="save" /><span>Guardar</span></button>
            <a tabindex="5" class="btn btn-outline-primary" href="cuentas-usuario">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    // Solo se editan cuentas existentes: las cuentas nuevas se crean junto con la persona
    [Parameter]
    public int Id { get; set; }

    private CuentaUsuarioViewModel ViewModel { get; set; } = new();

    protected override void OnParametersSet() {
        CuentaUsuarioViewModel? cuenta = DatosEjemplo.CuentasUsuario().FirstOrDefault(c => c.Id == Id);
        if (cuenta == null) {
            Nav.NavigateTo("/cuentas-usuario");
            return;
        }
        ViewModel = cuenta;
    }

    // Sin backend: solo regresa al listado. Al enlazar: PUT /cuentas/{Id}
    private void Guardar() {
        Nav.NavigateTo("/cuentas-usuario");
    }
}
