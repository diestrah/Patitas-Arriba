@page "/olvide-contrasena"
@layout LayoutVacio
@inject IAccesoService AccesoService

<PageTitle>Olvidé mi contraseña · Patitas Arriba</PageTitle>

<AccesoMarco Titulo="¿Olvidaste tu contraseña?" Subtitulo="Ingresa tu correo y te enviaremos un enlace para elegir una nueva.">
    @if (Enviado) {
        @* El mensaje es el mismo exista o no el correo (RN-AC-04): no se revela qué cuentas hay *@
        <div class="aviso-ok">
            Si el correo está registrado, te enviamos un enlace para restablecer tu contraseña.
            Es válido por 30 minutos y solo se puede usar una vez.
        </div>
        <p class="login-registro"><a href="login">Volver a iniciar sesión</a></p>
    } else {
        <EditForm Model="ViewModel" OnValidSubmit="Enviar">
            <DataAnnotationsValidator />

            @if (MensajeError != null) {
                <div class="login-error">@MensajeError</div>
            }

            <CampoAcceso Id="correo" Etiqueta="Correo electrónico" Icono="mail" Placeholder="nombre@correo.com" TabIndex="1"
                         Autocompletar="email" ModoEntrada="email" @bind-Value="ViewModel.Correo" />
            <button class="login-boton" type="submit" tabindex="2" disabled="@Enviando">
                @(Enviando ? "Enviando..." : "Enviar enlace")
            </button>
            <p class="login-registro"><a href="login">Volver a iniciar sesión</a></p>
        </EditForm>
    }
</AccesoMarco>

@code {
    private OlvideContrasenaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private bool Enviado { get; set; }
    private bool Enviando { get; set; }

    // POST /acceso/recuperacion: el backend responde igual exista o no el correo.
    // Solo falla si el correo no es válido o si no se pudo enviar el correo / conectar.
    private async Task Enviar() {
        if (Enviando) return;
        MensajeError = null;
        Enviando = true;
        try {
            await AccesoService.SolicitarRecuperacion(ViewModel.Correo);
            Enviado = true;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Enviando = false;
        }
    }
}
