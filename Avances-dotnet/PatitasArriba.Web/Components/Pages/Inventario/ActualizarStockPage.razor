@page "/articulos/stock/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Actualizar stock</PageTitle>

<div class="col-md-6">
    <h3 class="mb-3">Actualizar stock</h3>

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Artículo</label>
            <input class="form-control" value="@ViewModel.NombreArticulo" disabled />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Stock actual</label>
                <input class="form-control" value="@ViewModel.StockActual" disabled />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Nuevo stock</label>
                <PaInputNumber tabindex="1" class="form-control" @bind-Value="ViewModel.NuevoStock" />
                <ValidationMessage For="() => ViewModel.NuevoStock" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button tabindex="2" type="submit" class="btn btn-primary btn-texto"><Icono Nombre="save" /><span>Guardar</span></button>
            <a tabindex="3" class="btn btn-outline-primary" href="articulos">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int Id { get; set; }

    private ActualizarStockViewModel ViewModel { get; set; } = new();

    protected override void OnParametersSet() {
        ArticuloViewModel? articulo = DatosEjemplo.Articulos().FirstOrDefault(a => a.Id == Id);
        if (articulo == null) {
            Nav.NavigateTo("/articulos");
            return;
        }
        ViewModel = new ActualizarStockViewModel {
            IdArticulo = articulo.Id,
            NombreArticulo = articulo.Nombre,
            StockActual = articulo.StockActual,
            NuevoStock = articulo.StockActual
        };
    }

    // Sin backend: solo regresa al listado. El backend no tiene un endpoint solo para el stock:
    // al enlazar se lee el artículo (GET /articulos/{id}), se cambia su stock y se envía PUT /articulos/{id} (RN-AR-04)
    private void Guardar() {
        Nav.NavigateTo("/articulos");
    }
}
