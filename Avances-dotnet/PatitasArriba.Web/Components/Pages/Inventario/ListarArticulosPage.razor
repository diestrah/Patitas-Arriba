@page "/articulos"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Artículos</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Inventario de artículos</h3>
    @* El veterinario solo consulta: no ve los botones para registrar, editar ni eliminar *@
    @if (Sesion.EsAdministrador) {
        <button tabindex="5" class="btn btn-success" @onclick="() => NuevoArticulo()">
            Nuevo artículo
        </button>
    }
</div>

<div class="d-flex align-items-center gap-2 mb-3">
    <label class="text-nowrap">Nombre:</label>
    <input tabindex="1" class="form-control" placeholder="Ingrese el nombre..." @bind="Filtro" />
    <button tabindex="3" class="btn btn-primary">Filtrar</button>
    <button tabindex="4" class="btn btn-secondary">Limpiar</button>
</div>

@if (!Articulos.Any()) {
    <div class="alert alert-info">No hay artículos registrados.</div>
}
else {
    <QuickGrid Items="Articulos" Pagination="Paginacion" Class="table table-striped table-hover">
        <PropertyColumn Title="Nombre" Property="a => a.Nombre" Sortable="true" />
        <PropertyColumn Title="Categorías" Property="a => a.NombresCategorias" />
        <PropertyColumn Title="Precio (S/)" Property="a => a.PrecioBase" Format="N2"
                        Sortable="true" Align="Align.Right" />
        <PropertyColumn Title="Stock" Property="a => a.StockActual" Align="Align.Right" />
        <PropertyColumn Title="Stock mín." Property="a => a.StockMinimo" Align="Align.Right" />
        @if (Sesion.EsAdministrador) {
            <TemplateColumn Title="Acciones">
                <button class="btn btn-primary btn-sm" @onclick="() => EditarArticulo(context.Id)">
                    Editar
                </button>
                <button class="btn btn-outline-success btn-sm" @onclick="() => ActualizarStock(context.Id)">
                    Stock
                </button>
                <button class="btn btn-danger btn-sm">
                    Eliminar
                </button>
            </TemplateColumn>
        }
    </QuickGrid>
    <Paginator State="Paginacion"></Paginator>
}

@code {
    private IQueryable<ArticuloViewModel> Articulos { get; set; } = Enumerable.Empty<ArticuloViewModel>().AsQueryable();
    private string Filtro { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 8 };

    protected override void OnInitialized() {
        Articulos = DatosEjemplo.Articulos().AsQueryable();
    }

    private void NuevoArticulo() {
        Nav.NavigateTo("/articulos/nuevo");
    }

    private void EditarArticulo(int id) {
        Nav.NavigateTo($"/articulos/editar/{id}");
    }

    private void ActualizarStock(int id) {
        Nav.NavigateTo($"/articulos/stock/{id}");
    }
}
