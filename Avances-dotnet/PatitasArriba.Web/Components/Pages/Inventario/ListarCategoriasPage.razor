@page "/categorias"
@attribute [Authorize(Policy = "Categorias")]
@inject NavigationManager Nav;
@inject ICategoriaService CategoriaService;
@inject IArticuloService ArticuloService;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Categorías</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Categorías de artículos</h3>
    <button tabindex="1" class="btn btn-warning btn-texto" @onclick="() => NuevaCategoria()">
        <Icono Nombre="plus" /><span>Nueva categoría</span>
    </button>
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}
@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando categorías...</p>
}
else if (!Categorias.Any()) {
    <div class="alert alert-info">No hay categorías registradas.</div>
}
else {
    <div class="grilla-tarjetas">
        @foreach (CategoriaViewModel categoria in Categorias) {
            int cantidad = CantidadDe(categoria);
            <article class="tarjeta-info">
                <div class="tarjeta-enc">
                    <span class="ico-circ @ClaseColor(categoria.Nombre)" style="width: 56px; height: 56px; border-radius: 16px"><Icono Nombre="@NombreIcono(categoria.Nombre)" /></span>
                    <div>
                        <h5>@categoria.Nombre</h5>
                        <span class="etq etq-gris">@cantidad @(cantidad == 1 ? "artículo" : "artículos")</span>
                    </div>
                </div>
                <p class="tarjeta-desc">@categoria.Descripcion</p>
                <div class="tarjeta-pie">
                    <div class="acciones ms-auto">
                        <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarCategoria(categoria.Id)">
                            <Icono Nombre="edit" />
                        </button>
                        @if (cantidad > 0) {
                            <span class="btn-icono-bloqueado" tabindex="0" title="No se puede eliminar: tiene artículos asignados (RN-CA-03)" aria-label="Eliminar no disponible: tiene artículos asignados">
                                <Icono Nombre="lock" />
                            </span>
                        } else {
                            <button class="btn btn-outline-danger btn-icono" title="Eliminar" aria-label="Eliminar" @onclick="() => PedirEliminar(categoria)">
                                <Icono Nombre="trash" />
                            </button>
                        }
                    </div>
                </div>
            </article>
        }
    </div>
}

<ConfirmarDialogo Visible="CategoriaAEliminar != null"
                  Titulo="¿Eliminar la categoría?"
                  Mensaje="@($"“{CategoriaAEliminar?.Nombre}” dejará de aparecer. No se puede si tiene artículos asignados.")"
                  OnConfirmar="EliminarCategoria" OnCancelar="CancelarEliminacion" />

@code {
    private List<CategoriaViewModel> Todas { get; set; } = [];
    private IQueryable<CategoriaViewModel> Categorias { get; set; } = Enumerable.Empty<CategoriaViewModel>().AsQueryable();
    private CategoriaViewModel? CategoriaAEliminar { get; set; }
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private List<ArticuloViewModel> Articulos { get; set; } = [];
    private bool Cargando { get; set; } = true;

    // GET /categorias. Solo en la pasada interactiva: así el prerenderizado no repite la consulta
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        await Cargar();
    }

    private async Task Cargar() {
        try {
            Todas = await CategoriaService.FindAll();
            Categorias = Todas.AsQueryable();
            // GET /articulos: solo para contar cuántos tiene cada categoría y bloquear el eliminar
            Articulos = await ArticuloService.FindAll();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    private int CantidadDe(CategoriaViewModel categoria) {
        return Articulos.Count(a => a.Categorias.Any(c => c.Seleccionado && c.Id == categoria.Id));
    }

    // Icono y color según el nombre: así se reconoce cada categoría de un vistazo
    private static string NombreIcono(string nombre) {
        string n = nombre.ToLowerInvariant();
        if (n.Contains("medic") || n.Contains("farm") || n.Contains("antiparas")) return "pill";
        if (n.Contains("vacun")) return "syringe";
        if (n.Contains("aliment") || n.Contains("comida")) return "bowl";
        if (n.Contains("accesor") || n.Contains("juguet")) return "tag";
        if (n.Contains("higien") || n.Contains("limpi")) return "sparkle";
        return "box";
    }

    private static string ClaseColor(string nombre) {
        string n = nombre.ToLowerInvariant();
        if (n.Contains("medic") || n.Contains("farm") || n.Contains("antiparas")) return "k-med";
        if (n.Contains("vacun")) return "k-vac";
        if (n.Contains("aliment") || n.Contains("comida")) return "k-ali";
        if (n.Contains("accesor") || n.Contains("juguet")) return "k-acc";
        if (n.Contains("higien") || n.Contains("limpi")) return "k-hig";
        return "k-gen";
    }

    private void NuevaCategoria() {
        Nav.NavigateTo("/categorias/nuevo");
    }

    private void EditarCategoria(int id) {
        Nav.NavigateTo($"/categorias/editar/{id}");
    }

    private void PedirEliminar(CategoriaViewModel categoria) {
        CategoriaAEliminar = categoria;
    }

    private void CancelarEliminacion() {
        CategoriaAEliminar = null;
    }

    // DELETE /categorias/{id}. El backend no elimina una categoría con artículos asignados (RN-CA-03):
    // en ese caso se muestra su mensaje
    private async Task EliminarCategoria() {
        if (CategoriaAEliminar == null) {
            return;
        }
        CategoriaViewModel categoria = CategoriaAEliminar;
        CategoriaAEliminar = null;
        MensajeExito = null;
        MensajeError = null;
        try {
            await CategoriaService.Delete(categoria.Id);
            Todas.Remove(categoria);
            Categorias = Todas.AsQueryable();
            MensajeExito = $"Se eliminó la categoría “{categoria.Nombre}”.";
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
    }
}
