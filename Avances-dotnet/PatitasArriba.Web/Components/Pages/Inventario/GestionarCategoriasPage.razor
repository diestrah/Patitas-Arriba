@page "/categorias/nuevo"
@page "/categorias/editar/{Id:int}"
@attribute [Authorize(Policy = "Categorias")]
@inject NavigationManager Nav;
@inject ICategoriaService CategoriaService;

<PageTitle>Categorías</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nueva categoría" : "Editar categoría")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    @if (Cargando) {
        <p class="text-muted">Cargando categoría...</p>
    } else {
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <PaInputText tabindex="1" class="form-control" @bind-Value="ViewModel.Nombre" />
            <ValidationMessage For="() => ViewModel.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <PaInputTextArea tabindex="2" class="form-control" rows="3" @bind-Value="ViewModel.Descripcion" />
            <ValidationMessage For="() => ViewModel.Descripcion" />
        </div>

        <div class="d-flex gap-2">
            <button tabindex="4" type="submit" class="btn btn-primary btn-texto" disabled="@Guardando"><Icono Nombre="save" /><span>@(Guardando ? "Guardando..." : "Guardar")</span></button>
            <a tabindex="5" class="btn btn-outline-primary" href="categorias">Cancelar</a>
        </div>
    </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private CategoriaViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; }
    private bool Guardando { get; set; }

    // Al editar: GET /categorias/{Id}; si no existe se vuelve al listado
    protected override async Task OnParametersSetAsync() {
        MensajeError = null;
        if (Id == null) {
            ViewModel = new CategoriaViewModel();
            return;
        }
        Cargando = true;
        if (!RendererInfo.IsInteractive) return;
        try {
            CategoriaViewModel? categoria = await CategoriaService.FindById(Id.Value);
            if (categoria == null) {
                Nav.NavigateTo("/categorias");
                return;
            }
            ViewModel = categoria;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // POST /categorias o PUT /categorias/{Id}; si el backend rechaza los datos se muestra su mensaje
    private async Task Guardar() {
        if (Guardando) return;
        MensajeError = null;
        Guardando = true;
        try {
            if (Id == null) {
                await CategoriaService.Insert(ViewModel);
            } else {
                await CategoriaService.Update(ViewModel);
            }
            Nav.NavigateTo("/categorias");
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
