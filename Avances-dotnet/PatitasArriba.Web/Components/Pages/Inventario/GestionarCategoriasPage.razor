@page "/categorias/nuevo"
@page "/categorias/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Categorías</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nueva categoría" : "Editar categoría")</h3>

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <PaInputText tabindex="1" class="form-control" @bind-Value="ViewModel.Nombre" />
            <ValidationMessage For="() => ViewModel.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <PaInputTextArea tabindex="2" class="form-control" rows="3" @bind-Value="ViewModel.Descripcion" />
            <ValidationMessage For="() => ViewModel.Descripcion" />
        </div>

        <div class="d-flex gap-2">
            <button tabindex="4" type="submit" class="btn btn-primary btn-texto"><Icono Nombre="save" /><span>Guardar</span></button>
            <a tabindex="5" class="btn btn-outline-primary" href="categorias">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private CategoriaViewModel ViewModel { get; set; } = new();

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new CategoriaViewModel();
            return;
        }
        CategoriaViewModel? categoria = DatosEjemplo.Categorias().FirstOrDefault(c => c.Id == Id);
        if (categoria == null) {
            Nav.NavigateTo("/categorias");
            return;
        }
        ViewModel = categoria;
    }

    // Sin backend: solo regresa al listado. Al enlazar: POST /categorias o PUT /categorias/{Id}
    private void Guardar() {
        Nav.NavigateTo("/categorias");
    }
}
