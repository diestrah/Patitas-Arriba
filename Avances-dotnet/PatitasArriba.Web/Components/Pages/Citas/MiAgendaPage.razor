@page "/mi-agenda"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject ICitaService CitaService;
@inject IServicioService ServicioService;
@inject IAtencionService AtencionService;

@using System.Globalization
@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Mi agenda</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Mi agenda</h3>
    <a class="btn btn-warning btn-texto" href="reportes/agenda-diaria">
        <Icono Nombre="file-text" /><span>Generar reporte</span>
    </a>
</div>

@* Misma navegación por días que la Agenda diaria del administrador *@
<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3">
    <button class="btn btn-outline-primary btn-icono" title="Día anterior" aria-label="Día anterior" @onclick="() => CambiarDia(-1)">
        <Icono Nombre="chevron-left" />
    </button>
    <strong class="text-center" style="min-width: 15rem">@TextoFecha</strong>
    <button class="btn btn-outline-primary btn-icono" title="Día siguiente" aria-label="Día siguiente" @onclick="() => CambiarDia(1)">
        <Icono Nombre="chevron-right" />
    </button>
    <input type="date" class="form-control w-auto" aria-label="Elegir fecha" @bind="Fecha" @bind:format="yyyy-MM-dd" @bind:after="Cargar" />
    <button class="btn btn-outline-primary" @onclick="() => IrAHoy()">Hoy</button>
</div>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando su agenda...</p>
}
else if (Lista.Count == 0) {
    @if (MensajeError == null) {
        <div class="alert alert-info">No tiene servicios programados para este día.</div>
    }
}
else {
    <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
        <strong class="me-1">@Lista.Count servicio@(Lista.Count == 1 ? "" : "s")</strong>
        <span class="estado estado-pendiente">@Contar(EstadoServicioAgenda.PorAtender) por atender</span>
        <span class="estado estado-aprobado">@Contar(EstadoServicioAgenda.Atendido) atendido@(Contar(EstadoServicioAgenda.Atendido) == 1 ? "" : "s")</span>
        @if (Contar(EstadoServicioAgenda.PorAprobar) > 0) {
            <span class="estado estado-por-aprobar">@Contar(EstadoServicioAgenda.PorAprobar) por aprobar</span>
        }
    </div>

    <QuickGrid Items="Agenda" Class="table table-striped table-hover align-middle">
        <TemplateColumn Title="Hora">
            <span class="text-nowrap">@context.FechaHora.ToString("HH:mm") – @context.FechaHoraFin.ToString("HH:mm")</span>
        </TemplateColumn>
        <TemplateColumn Title="Mascota">
            <div class="d-flex align-items-center gap-2">
                <AvatarMascota Nombre="@context.NombreMascota" Foto="@Foto(context.IdMascota)" Tamano="chico" />
                <span>
                    @context.NombreMascota
                    @if (context.EsEmergencia) {
                        <span class="badge text-bg-danger ms-1">Emergencia</span>
                    }
                </span>
            </div>
        </TemplateColumn>
        <PropertyColumn Title="Dueño" Property="i => i.NombreCliente" />
        <PropertyColumn Title="Servicio" Property="i => i.NombreServicio" />
        @* Por aprobar, por atender o atendido: igual que en la Agenda diaria del administrador *@
        <TemplateColumn Title="Estado">
            <span class="estado @ClaseEstado(context)">@TextoEstado(context)</span>
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            @* Espacios fijos: ver cita | atender o ver la atención | historial. Si una acción no aplica, queda un guion *@
            <div class="acciones-fija">
                <span class="slot-icono">
                    <button class="btn btn-outline-primary btn-icono" title="Ver cita" aria-label="Ver cita" @onclick="() => VerCita(context.IdCita)">
                        <Icono Nombre="eye" />
                    </button>
                </span>
                <span class="slot-texto">
                    @* Cada servicio se atiende una sola vez (RN-AT-02); después solo se edita su atención.
                       Solo se atiende con la cita aprobada, o pendiente si es emergencia (RN-AT-04), y desde su hora (RN-AT-05) *@
                    @if (Atenciones.ContainsKey(context.IdDetalleCita)) {
                        <button class="btn btn-outline-primary btn-sm btn-texto" @onclick="() => EditarAtencion(Atenciones[context.IdDetalleCita])">
                            <Icono Nombre="edit" /><span>Ver atención</span>
                        </button>
                    } else if (MotivoSinAtender(context) == null) {
                        <button class="btn btn-primary btn-sm btn-texto" @onclick="() => Atender(context.IdDetalleCita)">
                            <Icono Nombre="activity" /><span>Atender</span>
                        </button>
                    } else {
                        <span class="slot-guion" title="@MotivoSinAtender(context)">—</span>
                    }
                </span>
                <span class="slot-texto">
                    <button class="btn btn-secondary btn-sm btn-texto" @onclick="() => VerHistorial(context.IdMascota)">
                        <Icono Nombre="clipboard" /><span>Historial</span>
                    </button>
                </span>
            </div>
        </TemplateColumn>
    </QuickGrid>
}

@* La cita completa: un servicio puede ser solo una parte de una cita con varios servicios y veterinarios *@
@if (CitaSeleccionada != null) {
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0">
                <DetalleCita Cita="CitaSeleccionada" Atendidos="Atendidos">
                    <button type="button" class="btn btn-outline-primary ms-auto" @onclick="() => CitaSeleccionada = null">Cerrar</button>
                </DetalleCita>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

@code {
    private static readonly CultureInfo Peru = new("es-PE");

    // Agenda del veterinario que inició sesión: GET /citas?fecha=AAAA-MM-DD&veterinario={id}
    private List<ItemAgendaViewModel> Lista { get; set; } = [];
    private List<CitaViewModel> Citas { get; set; } = [];
    private List<ServicioViewModel> Servicios { get; set; } = [];
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private IQueryable<ItemAgendaViewModel> Agenda { get; set; } = Enumerable.Empty<ItemAgendaViewModel>().AsQueryable();
    private DateTime Fecha { get; set; } = DateTime.Today;
    private CitaViewModel? CitaSeleccionada { get; set; }

    // Id del servicio de la cita (detalle_cita) -> id de su atención
    private Dictionary<int, int> Atenciones { get; set; } = [];
    private HashSet<int> Atendidos { get; set; } = [];
    private Dictionary<int, string?> Fotos { get; set; } = [];

    private string TextoFecha => Fecha.ToString("dddd d 'de' MMMM 'de' yyyy", Peru);

    // GET /servicios (duración de cada servicio) y GET /atenciones (para "Atender" o "Editar atención");
    // luego la agenda del día
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        if (Sesion.Rol != RolUsuario.VETERINARIO) {
            MensajeError = "Inicie sesión con una cuenta de veterinario para ver su agenda.";
            Cargando = false;
            return;
        }
        try {
            Task<List<ServicioViewModel>> servicios = ServicioService.FindAll();
            Task<Dictionary<int, int>> atenciones = AtencionService.AtencionPorDetalleCita();
            Servicios = await servicios;
            Atenciones = await atenciones;
            Atendidos = Atenciones.Keys.ToHashSet();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
            Cargando = false;
            return;
        }
        await Cargar();
    }

    // GET /citas?fecha=AAAA-MM-DD&veterinario={id}. Una cita puede tener servicios de otros veterinarios:
    // en la lista solo quedan los suyos
    private async Task Cargar() {
        if (Sesion.Rol != RolUsuario.VETERINARIO) return;
        Cargando = true;
        MensajeError = null;
        DateTime fecha = Fecha;
        try {
            List<CitaViewModel> citas = await CitaService.FindByFecha(DateOnly.FromDateTime(fecha), Sesion.IdPersona);
            // Si mientras tanto se cambió de día, esta respuesta ya no corresponde
            if (fecha != Fecha) return;
            Citas = citas;
            Fotos = citas.GroupBy(c => c.IdMascota).ToDictionary(g => g.Key, g => g.First().FotoMascota);
            Lista = AgendaVeterinario.DelVeterinario(Sesion.IdPersona, AgendaClinica.DelDia(fecha, citas, Servicios));
            Agenda = Lista.AsQueryable();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
            Lista = [];
            Agenda = Lista.AsQueryable();
        } finally {
            if (fecha == Fecha) Cargando = false;
        }
    }

    private Task CambiarDia(int dias) {
        Fecha = Fecha.AddDays(dias);
        return Cargar();
    }

    private Task IrAHoy() {
        Fecha = DateTime.Today;
        return Cargar();
    }

    private int Contar(EstadoServicioAgenda estado) => Lista.Count(i => AgendaTexto.De(i, Atendidos) == estado);
    private string ClaseEstado(ItemAgendaViewModel item) => AgendaTexto.ClaseEstado(AgendaTexto.De(item, Atendidos));
    private string TextoEstado(ItemAgendaViewModel item) => AgendaTexto.Texto(AgendaTexto.De(item, Atendidos));
    private string? MotivoSinAtender(ItemAgendaViewModel item) => AgendaVeterinario.MotivoSinAtender(item, Atendidos, DateTime.Now);
    private string? Foto(int idMascota) => Fotos.GetValueOrDefault(idMascota);

    private void VerCita(int idCita) {
        CitaSeleccionada = Citas.FirstOrDefault(c => c.Id == idCita);
    }

    private void Atender(int idDetalleCita) {
        Nav.NavigateTo($"/atenciones/registrar/{idDetalleCita}");
    }

    private void EditarAtencion(int idAtencion) {
        Nav.NavigateTo($"/atenciones/editar/{idAtencion}");
    }

    private void VerHistorial(int idMascota) {
        Nav.NavigateTo($"/reportes/historial-clinico/{idMascota}");
    }
}
