@page "/citas"
@attribute [Authorize(Policy = "Citas")]
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject ICitaService CitaService;
@inject IAtencionService AtencionService;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Gestión de citas</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Gestión de citas</h3>
    <button tabindex="4" class="btn btn-warning btn-texto" @onclick="() => NuevaCita()">
        <Icono Nombre="plus" /><span>Registrar cita</span>
    </button>
</div>

<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3">
    <input tabindex="1" class="form-control w-auto flex-grow-1" style="min-width: 12rem" placeholder="Mascota o dueño" aria-label="Buscar por mascota o dueño" @bind="TextoFiltro" />
    <label class="text-nowrap" for="filtro-estado">Estado:</label>
    <select id="filtro-estado" tabindex="2" class="form-select w-auto" @bind="EstadoFiltro">
        <option value="">Todos</option>
        @foreach (EstadoCita estado in Enum.GetValues<EstadoCita>()) {
            <option value="@estado">@TextoEnum.De(estado)</option>
        }
    </select>
    <label class="text-nowrap" for="filtro-fecha">Fecha:</label>
    <input id="filtro-fecha" tabindex="3" type="date" class="form-control w-auto" @bind="FechaFiltro" @bind:format="yyyy-MM-dd" />
    <button tabindex="4" class="btn btn-primary btn-texto" @onclick="() => Filtrar()">
        <Icono Nombre="search" /><span>Filtrar</span>
    </button>
    <button tabindex="5" class="btn btn-secondary" @onclick="() => VerTodas()">Limpiar</button>
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}
@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando citas...</p>
}
else if (!Citas.Any()) {
    <div class="alert alert-info">No hay citas para mostrar.</div>
}
else {
    <QuickGrid Items="Citas" Pagination="Paginacion" Class="table table-striped table-hover align-middle">
        <PropertyColumn Title="N.°" Property="c => c.Id" Sortable="true" />
        <PropertyColumn Title="Fecha y hora" Property="c => c.FechaHora" Format="dd/MM/yyyy HH:mm" Sortable="true" />
        <TemplateColumn Title="Mascota">
            @context.NombreMascota
            @if (context.EsEmergencia) {
                <span class="badge text-bg-danger ms-1">Emergencia</span>
            }
        </TemplateColumn>
        <PropertyColumn Title="Cliente" Property="c => c.NombreCliente" />
        <TemplateColumn Title="Estado">
            <BadgeEstadoCita Estado="context.Estado" />
        </TemplateColumn>
        <TemplateColumn Title="Acciones">
            @* Espacios fijos: ver | editar | acción positiva | acción negativa.
               Solo aparecen las acciones que el backend permite; si una no aplica, queda un guion *@
            <div class="acciones-fija">
                <span class="slot-icono">
                    <button class="btn btn-outline-primary btn-icono" title="Ver detalle" aria-label="Ver detalle" @onclick="() => SeleccionarCita(context)">
                        <Icono Nombre="eye" />
                    </button>
                </span>
                <span class="slot-icono">
                    @if (context.EsModificable) {
                        <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarCita(context.Id)">
                            <Icono Nombre="edit" />
                        </button>
                    } else {
                        <span class="slot-guion">—</span>
                    }
                </span>
                <span class="slot-texto">
                    @if (context.Estado == EstadoCita.PENDIENTE) {
                        <button class="btn btn-primary btn-sm btn-texto" @onclick="() => Aprobar(context)">
                            <Icono Nombre="check" /><span>Aprobar</span>
                        </button>
                    } else if (context.Estado == EstadoCita.APROBADO && PuedeCompletarse(context)) {
                        <button class="btn btn-primary btn-sm btn-texto" @onclick="() => Completar(context)">
                            <Icono Nombre="check-circle" /><span>Completar</span>
                        </button>
                    } else {
                        <span class="slot-guion">—</span>
                    }
                </span>
                <span class="slot-texto">
                    @if (context.Estado == EstadoCita.PENDIENTE) {
                        <button class="btn btn-outline-danger btn-sm btn-texto" @onclick="() => PedirCambio(context, EstadoCita.RECHAZADO)">
                            <Icono Nombre="x" /><span>Rechazar</span>
                        </button>
                    } else if (context.Estado == EstadoCita.APROBADO && PuedeCancelarse(context)) {
                        <button class="btn btn-outline-danger btn-sm btn-texto" @onclick="() => PedirCambio(context, EstadoCita.CANCELADO)">
                            <Icono Nombre="x" /><span>Cancelar cita</span>
                        </button>
                    } else {
                        <span class="slot-guion">—</span>
                    }
                </span>
            </div>
        </TemplateColumn>
    </QuickGrid>
    <Paginador State="Paginacion" />
}

@* El detalle de la cita elegida con "Ver" se abre en una ventana encima de la tabla *@
@if (CitaSeleccionada != null) {
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0">
                <DetalleCita Cita="CitaSeleccionada" Atendidos="Atendidos">
                    <button type="button" class="btn btn-outline-primary ms-auto" @onclick="() => CitaSeleccionada = null">Cerrar</button>
                </DetalleCita>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<ConfirmarDialogo Visible="CitaPorConfirmar != null"
                  Titulo="@(EstadoDestino == EstadoCita.RECHAZADO ? "¿Rechazar la cita?" : "¿Cancelar la cita?")"
                  Mensaje="@MensajeConfirmacion()"
                  TextoConfirmar="@(EstadoDestino == EstadoCita.RECHAZADO ? "Sí, rechazar" : "Sí, cancelar cita")"
                  TextoCancelar="No, volver"
                  IconoConfirmar="x"
                  OnConfirmar="ConfirmarCambio" OnCancelar="CancelarConfirmacion" />

@code {
    private List<CitaViewModel> Todas { get; set; } = [];
    private IQueryable<CitaViewModel> Citas { get; set; } = Enumerable.Empty<CitaViewModel>().AsQueryable();
    private CitaViewModel? CitaSeleccionada { get; set; }
    private DateTime? FechaFiltro { get; set; }
    private DateTime? FechaFiltroAplicada { get; set; }
    private string TextoFiltro { get; set; } = string.Empty;
    private string EstadoFiltro { get; set; } = string.Empty;
    private string TextoFiltroAplicado { get; set; } = string.Empty;
    private string EstadoFiltroAplicado { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 6 };
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;

    // Servicios de cita que ya tienen su atención registrada
    private HashSet<int> Atendidos { get; set; } = [];

    // Rechazar y cancelar piden confirmación
    private CitaViewModel? CitaPorConfirmar { get; set; }
    private EstadoCita EstadoDestino { get; set; }

    // GET /citas y, para saber qué servicios ya se atendieron (completar y cancelar dependen de eso), GET /atenciones.
    // Se cargan todas una vez y los filtros se aplican sobre esa lista.
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Task<List<CitaViewModel>> citas = CitaService.FindAll();
            Task<Dictionary<int, int>> atenciones = AtencionService.AtencionPorDetalleCita();
            Todas = await citas;
            Atendidos = (await atenciones).Keys.ToHashSet();
            Mostrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    private void Mostrar() {
        Citas = Todas
            .Where(c => FechaFiltroAplicada == null || c.FechaHora?.Date == FechaFiltroAplicada.Value.Date)
            .Where(c => EstadoFiltroAplicado == "" || c.Estado.ToString() == EstadoFiltroAplicado)
            .Where(c => TextoFiltroAplicado == ""
                     || c.NombreMascota.Contains(TextoFiltroAplicado, StringComparison.OrdinalIgnoreCase)
                     || c.NombreCliente.Contains(TextoFiltroAplicado, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(c => c.FechaHora)
            .AsQueryable();
    }

    // Los filtros se aplican al presionar Filtrar (como en el resto de listados)
    private void Filtrar() {
        FechaFiltroAplicada = FechaFiltro;
        TextoFiltroAplicado = TextoFiltro.Trim();
        EstadoFiltroAplicado = EstadoFiltro;
        Mostrar();
    }

    private void VerTodas() {
        FechaFiltro = null;
        FechaFiltroAplicada = null;
        TextoFiltro = string.Empty;
        EstadoFiltro = string.Empty;
        TextoFiltroAplicado = string.Empty;
        EstadoFiltroAplicado = string.Empty;
        Mostrar();
    }

    // RN-CI-10: se completa cuando todos sus servicios tienen su atención
    private bool PuedeCompletarse(CitaViewModel cita) {
        return cita.Detalles.All(d => Atendidos.Contains(d.Id));
    }

    // RN-CI-11: no se cancela si algún servicio ya fue atendido; tampoco si la cita ya pasó
    private bool PuedeCancelarse(CitaViewModel cita) {
        return !cita.Detalles.Any(d => Atendidos.Contains(d.Id)) && cita.FechaHora > DateTime.Now;
    }

    private void SeleccionarCita(CitaViewModel cita) {
        CitaSeleccionada = cita;
    }

    private void NuevaCita() {
        Nav.NavigateTo("/citas/nueva");
    }

    private void EditarCita(int id) {
        Nav.NavigateTo($"/citas/editar/{id}");
    }

    // PUT /citas/{id} con el nuevo estado y el administrador que decide (RN-CI-09);
    // si el backend lo rechaza, la cita queda como estaba y se muestra su mensaje.
    private async Task CambiarEstado(CitaViewModel cita, EstadoCita estado, string mensaje) {
        MensajeExito = null;
        MensajeError = null;
        try {
            await CitaService.CambiarEstado(cita, estado, Sesion.IdPersona, Sesion.NombreUsuario);
            MensajeExito = mensaje;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
        Mostrar();
    }

    private Task Aprobar(CitaViewModel cita) =>
        CambiarEstado(cita, EstadoCita.APROBADO, $"Se aprobó la cita N.° {cita.Id} de {cita.NombreMascota}.");

    private Task Completar(CitaViewModel cita) =>
        CambiarEstado(cita, EstadoCita.COMPLETADO, $"La cita N.° {cita.Id} de {cita.NombreMascota} quedó completada.");

    private void PedirCambio(CitaViewModel cita, EstadoCita estado) {
        CitaPorConfirmar = cita;
        EstadoDestino = estado;
    }

    private void CancelarConfirmacion() {
        CitaPorConfirmar = null;
    }

    private string MensajeConfirmacion() {
        if (CitaPorConfirmar == null) {
            return "";
        }
        string cita = $"{CitaPorConfirmar.NombreMascota} · {CitaPorConfirmar.TextoServicios} · {CitaPorConfirmar.FechaHora:dd/MM HH:mm}.";
        return EstadoDestino == EstadoCita.RECHAZADO
            ? $"{cita} El cliente verá la cita como rechazada."
            : $"{cita} Se liberará el horario del veterinario.";
    }

    private async Task ConfirmarCambio() {
        if (CitaPorConfirmar == null) {
            return;
        }
        CitaViewModel cita = CitaPorConfirmar;
        CitaPorConfirmar = null;
        string mensaje = EstadoDestino == EstadoCita.RECHAZADO
            ? $"Se rechazó la cita N.° {cita.Id}."
            : $"Se canceló la cita N.° {cita.Id}.";
        await CambiarEstado(cita, EstadoDestino, mensaje);
    }
}
