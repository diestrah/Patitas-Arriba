@page "/mis-citas/nueva"
@page "/mis-citas/editar/{Id:int}"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;

<PageTitle>Reservar cita</PageTitle>

<div class="col-lg-9">
    <h3 class="mb-3">@(Id == null ? "Reservar cita" : "Modificar reserva")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="row align-items-end">
            <div class="col-md-4 mb-3">
                <label class="form-label">Mascota</label>
                <InputSelect tabindex="1" class="form-select" @bind-Value="ViewModel.IdMascota" disabled="@(Id != null)">
                    <option value="0">Seleccione su mascota</option>
                    @foreach (MascotaViewModel mascota in Mascotas) {
                        <option value="@mascota.Id">@mascota.Nombre</option>
                    }
                </InputSelect>
                <ValidationMessage For="() => ViewModel.IdMascota" />
            </div>
            <div class="col-md-5 mb-3">
                <label class="form-label">Fecha y hora</label>
                <InputDate tabindex="2" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHora" />
                <ValidationMessage For="() => ViewModel.FechaHora" />
            </div>
            <div class="col-md-3 mb-3">
                <div class="form-check">
                    <InputCheckbox tabindex="3" id="reserva-emergencia" class="form-check-input" @bind-Value="ViewModel.EsEmergencia" disabled="@(Id != null)" />
                    <label class="form-check-label" for="reserva-emergencia">Es una emergencia</label>
                </div>
            </div>
        </div>

        <ServiciosCita Detalles="ViewModel.Detalles" Servicios="Servicios" Veterinarios="Veterinarios" />
        <ValidationMessage For="() => ViewModel.Detalles" />

        <div class="d-flex gap-2 mt-3">
            <button tabindex="4" type="submit" class="btn btn-primary btn-texto">
                <Icono Nombre="save" /><span>@(Id == null ? "Reservar" : "Guardar cambios")</span>
            </button>
            <a tabindex="5" class="btn btn-outline-primary" href="mis-citas">Cancelar</a>
        </div>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private CitaViewModel ViewModel { get; set; } = new();
    private List<MascotaViewModel> Mascotas { get; set; } = [];
    private List<ServicioViewModel> Servicios { get; set; } = [];
    private List<VeterinarioViewModel> Veterinarios { get; set; } = [];

    // Mensaje del backend cuando rechace la reserva (por ejemplo, el veterinario no atiende a esa hora)
    private string? MensajeError { get; set; }

    // Solo las mascotas del cliente que inició sesión
    protected override void OnInitialized() {
        Mascotas = DatosEjemplo.MascotasDeCliente(Sesion.IdPersona);
        Servicios = DatosEjemplo.Servicios();
        Veterinarios = DatosEjemplo.Veterinarios();
    }

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new CitaViewModel { IdCliente = Sesion.IdPersona };
            return;
        }
        CitaViewModel? cita = DatosEjemplo.CitasDeCliente(Sesion.IdPersona).FirstOrDefault(c => c.Id == Id);
        if (cita == null || !cita.EsModificable) {
            Nav.NavigateTo("/mis-citas");
            return;
        }
        ViewModel = cita;
    }

    // Sin backend: solo regresa a "Mis citas". Al enlazar: POST /citas (queda PENDIENTE) o PUT /citas/{Id}
    private void Guardar() {
        Nav.NavigateTo("/mis-citas");
    }
}
