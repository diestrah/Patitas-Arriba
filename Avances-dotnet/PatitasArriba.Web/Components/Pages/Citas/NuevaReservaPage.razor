@page "/mis-citas/nueva"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;

@using System.Globalization

<PageTitle>Reservar cita</PageTitle>

<div class="col-lg-10">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h3 class="mb-0">Reservar cita</h3>
        <a class="small fw-bold" href="mis-citas">Volver</a>
    </div>

    <div class="pasos-reserva mb-3">
        <span class="@ClasePaso(1)">1 Mascota</span>
        <span class="@ClasePaso(2)">2 Servicios</span>
        <span class="@ClasePaso(3)">3 Fecha y hora</span>
    </div>

    @* Las emergencias las registra la clínica: el cliente no las reserva desde la web *@
    <div class="alert alert-info">¿Es una emergencia? Llame o acérquese a la clínica; la atendemos de inmediato.</div>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    <div class="d-flex flex-column gap-3">
        <div class="card">
            <div class="card-header fw-bold">¿Para quién es la cita?</div>
            <div class="card-body">
                @if (Mascotas.Count == 0) {
                    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                        <span class="text-muted">Aún no tiene mascotas. Agregue la primera para poder reservar una cita.</span>
                        <a class="btn btn-primary btn-texto" href="mis-mascotas/nueva"><Icono Nombre="plus" /><span>Agregar mascota</span></a>
                    </div>
                } else {
                    <div class="opciones-reserva">
                        @foreach (MascotaViewModel mascota in Mascotas) {
                            <button type="button" class="opcion-tarjeta @(mascota.Id == IdMascota ? "activa" : "")" aria-pressed="@(mascota.Id == IdMascota)" @onclick="() => ElegirMascota(mascota.Id)">
                                <AvatarMascota Nombre="@mascota.Nombre" Foto="@mascota.Foto" Tamano="chico" />
                                <span>
                                    <strong>@mascota.Nombre</strong><br />
                                    <small>@TextoEnum.De(mascota.TipoMascota) · @(string.IsNullOrWhiteSpace(mascota.Raza) ? "Sin raza" : mascota.Raza)</small>
                                </span>
                            </button>
                        }
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-bold">Servicios <span class="text-muted fw-normal small">(elija uno o más)</span></div>
            <div class="card-body">
                <div class="opciones-reserva">
                    @foreach (ServicioViewModel servicio in Servicios) {
                        bool activo = IdsServicios.Contains(servicio.Id);
                        <button type="button" class="opcion-tarjeta @(activo ? "activa" : "")" aria-pressed="@activo" @onclick="() => AlternarServicio(servicio.Id)">
                            <span>
                                <strong>@servicio.Nombre</strong><br />
                                <small>@(servicio.DuracionEstimada ?? 30) min · S/ @servicio.PrecioBase.ToString("N2")</small>
                            </span>
                        </button>
                    }
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-bold">Fecha y hora</div>
            <div class="card-body">
                <label class="form-label" for="reserva-fecha">Fecha</label>
                <input id="reserva-fecha" type="date" class="form-control w-auto mb-3" min="@DateTime.Today.ToString("yyyy-MM-dd")"
                       @bind="Fecha" @bind:format="yyyy-MM-dd" @bind:after="CambiarFecha" />

                @if (Fecha == null) {
                    <p class="text-muted mb-0">Elija una fecha para ver los horarios libres.</p>
                } else if (IdsServicios.Count == 0) {
                    <p class="text-muted mb-0">Elija primero los servicios: la duración cambia los horarios que se pueden ofrecer.</p>
                } else if (Horarios.Count == 0) {
                    <div class="alert alert-warning mb-0">No hay veterinarios atendiendo ese día. Elija otra fecha.</div>
                } else {
                    <div class="fw-bold mb-2">Horarios disponibles el @Fecha.Value.ToString("dddd d 'de' MMMM", Peru)</div>
                    <div class="horas-libres">
                        @foreach (HorarioDisponible horario in Horarios) {
                            <button type="button" class="hora-btn @(Horario?.Inicio == horario.Inicio ? "activa" : "")" disabled="@(!horario.Libre)"
                                    aria-pressed="@(Horario?.Inicio == horario.Inicio)" @onclick="() => ElegirHorario(horario)">@horario.Inicio.ToString("HH:mm")</button>
                        }
                    </div>
                    @if (!Horarios.Any(h => h.Libre)) {
                        <div class="alert alert-warning mt-3 mb-0">Ese día ya no tiene horarios libres para esos servicios. Elija otra fecha.</div>
                    }
                }
            </div>
        </div>

        @if (Completo) {
            <div class="card">
                <div class="card-header fw-bold">Resumen</div>
                <div class="card-body d-flex flex-column gap-2">
                    <div class="resumen-reserva">
                        <div><strong>@MascotaElegida?.Nombre</strong> · @string.Join(" + ", ServiciosElegidos.Select(s => s.Nombre))</div>
                        <div>@Horario!.Inicio.ToString("dddd d 'de' MMMM, HH:mm", Peru) · duración @DuracionTotal min</div>
                        <div>Veterinario@(VeterinariosAsignados.Count == 1 ? "" : "s"): @string.Join(", ", VeterinariosAsignados) <span class="text-muted">(asignado automáticamente según el horario)</span></div>
                        <div><strong>Total estimado: S/ @PrecioTotal.ToString("N2")</strong> · se paga en la clínica</div>
                    </div>
                    <div class="alert alert-warning mb-0">Su cita quedará <strong>Pendiente</strong> hasta que la clínica la apruebe.</div>
                    <div class="d-flex justify-content-end gap-2">
                        <a class="btn btn-outline-primary" href="mis-citas">Cancelar</a>
                        <button type="button" class="btn btn-primary btn-texto" @onclick="() => Reservar()">
                            <Icono Nombre="check" /><span>Confirmar reserva</span>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private static readonly CultureInfo Peru = new("es-PE");

    // Pre-selecciona la mascota cuando se llega desde "Reservar para {mascota}"
    [SupplyParameterFromQuery(Name = "mascota")]
    public int? MascotaInicial { get; set; }

    private List<MascotaViewModel> Mascotas { get; set; } = [];
    private List<ServicioViewModel> Servicios { get; set; } = [];
    private int IdMascota { get; set; }
    private List<int> IdsServicios { get; set; } = [];
    private DateTime? Fecha { get; set; }
    private List<HorarioDisponible> Horarios { get; set; } = [];
    private HorarioDisponible? Horario { get; set; }

    // Mensaje del backend cuando rechace la reserva (por ejemplo, el veterinario ya no está libre a esa hora)
    private string? MensajeError { get; set; }

    private MascotaViewModel? MascotaElegida => Mascotas.FirstOrDefault(m => m.Id == IdMascota);
    private List<ServicioViewModel> ServiciosElegidos => Servicios.Where(s => IdsServicios.Contains(s.Id)).ToList();
    private int DuracionTotal => ServiciosElegidos.Sum(s => s.DuracionEstimada ?? 30);
    private double PrecioTotal => ServiciosElegidos.Sum(s => s.PrecioBase);
    private List<string> VeterinariosAsignados => Horario == null ? [] : Horario.Detalles.Select(d => d.NombreVeterinario).Distinct().ToList();
    private bool Completo => MascotaElegida != null && IdsServicios.Count > 0 && Horario != null;

    // Solo las mascotas del cliente que inició sesión. La emergencia no se ofrece: la registra la clínica.
    // Al enlazar: GET /mascotas?cliente={id} y GET /servicios
    protected override void OnInitialized() {
        Mascotas = DatosEjemplo.MascotasDeCliente(Sesion.IdPersona);
        Servicios = DatosEjemplo.Servicios().Where(s => s.TipoServicio != TipoServicio.EMERGENCIA).ToList();
        if (MascotaInicial != null && Mascotas.Any(m => m.Id == MascotaInicial)) {
            IdMascota = MascotaInicial.Value;
        }
    }

    private string ClasePaso(int paso) {
        bool listo = paso switch { 1 => IdMascota != 0, 2 => IdsServicios.Count > 0, _ => Horario != null };
        bool anteriorListo = paso == 1 || (paso == 2 && IdMascota != 0) || (paso == 3 && IdMascota != 0 && IdsServicios.Count > 0);
        return listo ? "paso-chip listo" : anteriorListo ? "paso-chip activo" : "paso-chip";
    }

    private void ElegirMascota(int id) {
        IdMascota = id;
    }

    // Cambiar los servicios cambia la duración, así que se recalculan los horarios libres
    private void AlternarServicio(int id) {
        if (!IdsServicios.Remove(id)) {
            IdsServicios.Add(id);
        }
        Recalcular();
    }

    private void CambiarFecha() {
        Recalcular();
    }

    private void Recalcular() {
        Horario = null;
        Horarios = Fecha == null ? [] : DisponibilidadCitas.HorariosDelDia(Fecha.Value, ServiciosElegidos);
    }

    private void ElegirHorario(HorarioDisponible horario) {
        Horario = horario;
    }

    // Sin backend: solo regresa a "Mis citas". Al enlazar: POST /citas con IdCliente, IdMascota, la fecha y hora,
    // EsEmergencia = false y un detalle por servicio con su veterinario. Queda PENDIENTE hasta que el administrador la apruebe.
    private void Reservar() {
        Nav.NavigateTo("/mis-citas");
    }
}
