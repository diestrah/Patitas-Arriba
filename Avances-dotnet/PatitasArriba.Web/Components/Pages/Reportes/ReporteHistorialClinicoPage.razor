@page "/reportes/historial-clinico"
@page "/reportes/historial-clinico/{IdMascota:int}"
@inject NavigationManager Nav;
@inject IJSRuntime JS;

<PageTitle>Historial clínico</PageTitle>

<h3 class="mb-3">Reporte de historial clínico</h3>

@* La mascota se busca por su nombre, el de su dueño o el DNI del dueño: con muchas mascotas, una lista desplegable es poco práctica.
   Enter en el buscador también busca *@
<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3 no-print">
    <label class="text-nowrap" for="hc-buscar">Mascota:</label>
    <input id="hc-buscar" tabindex="1" class="form-control w-auto flex-grow-1" style="min-width: 14rem" placeholder="Nombre de la mascota o del dueño, o DNI del dueño"
           @bind="TextoBusqueda" @bind:event="oninput" @onkeydown="TeclaEnBusqueda" />
    <button tabindex="2" class="btn btn-primary btn-texto" @onclick="() => Buscar()"><Icono Nombre="search" /><span>Buscar</span></button>
    <button tabindex="3" class="btn btn-secondary btn-texto" @onclick="() => Imprimir()" disabled="@(Mascota == null)"><Icono Nombre="printer" /><span>Imprimir / exportar PDF</span></button>
</div>

@if (Resultados != null) {
    <div class="mb-4 no-print">
        @if (Resultados.Count == 0) {
            <div class="alert alert-warning mb-0">No se encontró ninguna mascota con “@TextoBuscado”.</div>
        } else {
            <p class="small text-muted mb-2">Elija la mascota para ver su historial clínico:</p>
            <div class="d-flex flex-wrap gap-2">
                @foreach (MascotaViewModel resultado in Resultados) {
                    <button type="button" class="btn btn-outline-primary d-flex align-items-center gap-2 text-start" @onclick="() => Elegir(resultado.Id)">
                        <AvatarMascota Nombre="@resultado.Nombre" Foto="@resultado.Foto" Tamano="chico" />
                        <span>
                            <strong>@resultado.Nombre</strong>
                            <span class="d-block small">@resultado.NombreDueno</span>
                        </span>
                    </button>
                }
            </div>
        }
    </div>
}

@if (Mascota == null) {
    if (Resultados == null) {
        <div class="alert alert-info">Busque la mascota por su nombre, el de su dueño o el DNI del dueño para ver su historial clínico.</div>
    }
}
else {
    <div class="row g-4">
        <div class="col-lg-4">
            <TarjetaMascota Mascota="Mascota" MostrarDueno="true" />
        </div>
        <div class="col-lg-8">
            <h5 class="mb-3">Atenciones (@Historial.Count)</h5>

            @if (Historial.Count == 0) {
                <div class="alert alert-info">La mascota todavía no tiene atenciones registradas.</div>
            }

            @foreach (AtencionViewModel atencion in Historial) {
                RecetaViewModel? receta = DatosEjemplo.RecetaDeAtencion(atencion.Id);
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between">
                        <span class="fw-bold">@(atencion.FechaHora?.ToString("dd/MM/yyyy HH:mm")) · @atencion.NombreServicio</span>
                        <span class="text-muted small">@atencion.NombreVeterinario</span>
                    </div>
                    <div class="card-body">
                        @if (!string.IsNullOrWhiteSpace(atencion.MotivoConsulta)) {
                            <p class="mb-1"><strong>Motivo:</strong> @atencion.MotivoConsulta</p>
                        }
                        <p><strong>Observaciones:</strong> @atencion.Observaciones</p>

                        <h6>Diagnósticos</h6>
                        <TablaDiagnosticos Diagnosticos="atencion.Diagnosticos" SoloLectura="true" />

                        <h6>Insumos utilizados</h6>
                        <TablaInsumos Insumos="atencion.Insumos" SoloLectura="true" />

                        @if (receta != null) {
                            <h6>Receta N.° @receta.Id.ToString("D6")</h6>
                            <DetalleReceta Receta="receta" />
                        }
                    </div>
                </div>
            }
        </div>
    </div>
}

@code {
    [Parameter]
    public int? IdMascota { get; set; }

    private List<MascotaViewModel> Mascotas { get; set; } = [];
    private MascotaViewModel? Mascota { get; set; }

    // Búsqueda: lo que se escribe, lo que se buscó y las mascotas encontradas (null mientras no se busca)
    private string TextoBusqueda { get; set; } = string.Empty;
    private string TextoBuscado { get; set; } = string.Empty;
    private List<MascotaViewModel>? Resultados { get; set; }
    private List<AtencionViewModel> Historial { get; set; } = [];

    protected override void OnInitialized() {
        Mascotas = DatosEjemplo.Mascotas();
    }

    protected override void OnParametersSet() {
        Resultados = null;
        if (IdMascota == null) {
            Mascota = null;
            Historial = [];
            return;
        }
        Mascota = Mascotas.FirstOrDefault(m => m.Id == IdMascota);
        Historial = DatosEjemplo.HistorialDeMascota(IdMascota.Value);
    }

    // Abre el diálogo de impresión del navegador; desde ahí también se guarda como PDF
    private async Task Imprimir() {
        await JS.InvokeVoidAsync("print");
    }

    private void TeclaEnBusqueda(KeyboardEventArgs e) {
        if (e.Key == "Enter") {
            Buscar();
        }
    }

    // Por nombre de la mascota o del dueño, o por el DNI del dueño (solo números). Si hay una sola, la abre.
    // Al enlazar: GET /mascotas y, para el DNI, GET /clientes?dni=... seguido de GET /mascotas?cliente={id}
    private void Buscar() {
        string texto = TextoBusqueda.Trim();
        if (texto.Length == 0) {
            return;
        }
        TextoBuscado = texto;
        HashSet<int> duenos = texto.All(char.IsDigit)
            ? DatosEjemplo.Clientes().Where(c => c.Dni.StartsWith(texto)).Select(c => c.Id).ToHashSet()
            : new HashSet<int>();
        Resultados = Mascotas
            .Where(m => m.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase)
                     || m.NombreDueno.Contains(texto, StringComparison.OrdinalIgnoreCase)
                     || duenos.Contains(m.IdCliente))
            .ToList();
        if (Resultados.Count == 1) {
            Elegir(Resultados[0].Id);
        }
    }

    // Navega a la URL del historial de la mascota elegida
    private void Elegir(int idMascota) {
        Nav.NavigateTo($"/reportes/historial-clinico/{idMascota}");
    }
}
