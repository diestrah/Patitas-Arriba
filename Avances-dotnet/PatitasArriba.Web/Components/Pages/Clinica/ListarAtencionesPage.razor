@page "/atenciones"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject IAtencionService AtencionService;
@inject IRecetaService RecetaService;
@inject IBoletaService BoletaService;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Atenciones</PageTitle>

<h3 class="mb-3">Atenciones</h3>

<div class="barra-filtros d-flex flex-wrap align-items-center gap-2 mb-3">
    <input tabindex="1" class="form-control w-auto flex-grow-1" style="min-width: 12rem" placeholder="Mascota o dueño" aria-label="Buscar por mascota o dueño" @bind="Filtro" />
    <label class="text-nowrap" for="filtro-fecha">Fecha:</label>
    <input id="filtro-fecha" tabindex="2" type="date" class="form-control w-auto" @bind="FechaFiltro" @bind:format="yyyy-MM-dd" />
    <div class="form-check mb-0 text-nowrap">
        <input id="filtro-mias" tabindex="3" type="checkbox" class="form-check-input" @bind="SoloMias" />
        <label class="form-check-label" for="filtro-mias">Solo mis atenciones</label>
    </div>
    <button tabindex="4" class="btn btn-primary btn-texto" @onclick="() => Filtrar()">
        <Icono Nombre="search" /><span>Filtrar</span>
    </button>
    <button tabindex="5" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}
@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando atenciones...</p>
}
else if (!Atenciones.Any()) {
    <div class="alert alert-info">No se encontraron atenciones.</div>
}
else {
    <QuickGrid Items="Atenciones" Pagination="Paginacion" Class="table table-striped table-hover align-middle">
        <PropertyColumn Title="Fecha" Property="a => a.FechaHora" Format="dd/MM/yyyy HH:mm" Sortable="true" />
        <PropertyColumn Title="Mascota" Property="a => a.NombreMascota" Sortable="true" />
        <PropertyColumn Title="Dueño" Property="a => a.NombreCliente" />
        <PropertyColumn Title="Servicio" Property="a => a.NombreServicio" />
        <PropertyColumn Title="Veterinario" Property="a => a.NombreVeterinario" />
        <TemplateColumn Title="Acciones">
            @* Espacios fijos: ver | editar | receta (positiva) | anular (negativa). Si una acción no aplica, queda un guion *@
            <div class="acciones-fija">
                <span class="slot-icono">
                    <button class="btn btn-outline-primary btn-icono" title="Ver detalle" aria-label="Ver detalle" @onclick="() => AtencionSeleccionada = context">
                        <Icono Nombre="eye" />
                    </button>
                </span>
                <span class="slot-icono">
                    <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarAtencion(context.Id)">
                        <Icono Nombre="edit" />
                    </button>
                </span>
                <span class="slot-texto">
                    @* RN-RE-02: no se emiten recetas en servicios estéticos. Si ya tiene receta, se abre la existente *@
                    @if (RecetaDe(context) is RecetaViewModel receta) {
                        <button class="btn btn-outline-primary btn-sm btn-texto" @onclick="() => VerReceta(receta.Id)">
                            <Icono Nombre="file-text" /><span>Ver receta</span>
                        </button>
                    } else if (context.EsServicioMedico) {
                        <button class="btn btn-secondary btn-sm btn-texto" @onclick="() => NuevaReceta(context.Id)">
                            <Icono Nombre="file-text" /><span>Receta</span>
                        </button>
                    } else {
                        <span class="slot-guion" title="Los servicios estéticos no llevan receta">—</span>
                    }
                </span>
                <span class="slot-texto">
                    @* RN-AT-10: no se anula si tiene recetas emitidas o insumos cobrados *@
                    @if (PuedeAnularse(context)) {
                        <button class="btn btn-outline-danger btn-sm btn-texto" @onclick="() => PedirAnulacion(context)">
                            <Icono Nombre="ban" /><span>Anular</span>
                        </button>
                    } else {
                        <span class="slot-guion" title="Tiene receta o insumos ya cobrados">—</span>
                    }
                </span>
            </div>
        </TemplateColumn>
    </QuickGrid>
    <Paginador State="Paginacion" />
}

@* Detalle de la atención elegida con "Ver": se abre en una ventana encima de la tabla *@
@if (AtencionSeleccionada != null) {
    RecetaViewModel? recetaSeleccionada = RecetaDe(AtencionSeleccionada);
    <div class="modal d-block" tabindex="-1" role="dialog" aria-modal="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0">
                <div class="card">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span class="fw-bold">@AtencionSeleccionada.NombreMascota · @AtencionSeleccionada.NombreServicio</span>
                        <span class="text-muted small">@(AtencionSeleccionada.FechaHora?.ToString("dd/MM/yyyy HH:mm"))</span>
                    </div>
                    <div class="card-body">
                        <ul class="list-unstyled small mb-3">
                            <li><strong>Dueño:</strong> @AtencionSeleccionada.NombreCliente</li>
                            <li><strong>Veterinario:</strong> @AtencionSeleccionada.NombreVeterinario</li>
                            @if (!string.IsNullOrWhiteSpace(AtencionSeleccionada.MotivoConsulta)) {
                                <li><strong>Motivo:</strong> @AtencionSeleccionada.MotivoConsulta</li>
                            }
                            <li><strong>Observaciones:</strong> @(AtencionSeleccionada.Observaciones ?? "—")</li>
                        </ul>

                        @if (AtencionSeleccionada.EsServicioMedico) {
                            <h6>Diagnósticos</h6>
                            <TablaDiagnosticos Diagnosticos="AtencionSeleccionada.Diagnosticos" SoloLectura="true" />
                        }

                        <h6>Insumos utilizados</h6>
                        <TablaInsumos Insumos="AtencionSeleccionada.Insumos" SoloLectura="true" />

                        @if (recetaSeleccionada != null) {
                            <h6>Receta N.° @recetaSeleccionada.Id.ToString("D6")</h6>
                            <DetalleReceta Receta="recetaSeleccionada" />
                        }
                    </div>
                    <div class="card-footer d-flex flex-wrap gap-2">
                        <button type="button" class="btn btn-outline-primary btn-texto" @onclick="() => EditarAtencion(AtencionSeleccionada.Id)">
                            <Icono Nombre="edit" /><span>Editar</span>
                        </button>
                        <button type="button" class="btn btn-secondary btn-texto" @onclick="() => VerHistorial(AtencionSeleccionada.IdMascota)">
                            <Icono Nombre="clipboard" /><span>Historial</span>
                        </button>
                        <button type="button" class="btn btn-outline-primary ms-auto" @onclick="() => AtencionSeleccionada = null">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="modal-backdrop fade show"></div>
}

<ConfirmarDialogo Visible="AtencionAAnular != null"
                  Titulo="¿Anular la atención?"
                  Mensaje="@($"{AtencionAAnular?.NombreServicio} de {AtencionAAnular?.NombreMascota}: sus insumos vuelven al stock y el servicio queda como no realizado (no se puede volver a atender).")"
                  TextoConfirmar="Sí, anular"
                  IconoConfirmar="ban"
                  OnConfirmar="AnularAtencion" OnCancelar="CancelarAnulacion" />

@code {
    private List<AtencionViewModel> Todas { get; set; } = [];
    private List<RecetaViewModel> Recetas { get; set; } = [];
    private IQueryable<AtencionViewModel> Atenciones { get; set; } = Enumerable.Empty<AtencionViewModel>().AsQueryable();
    private AtencionViewModel? AtencionSeleccionada { get; set; }
    private AtencionViewModel? AtencionAAnular { get; set; }
    private HashSet<int> InsumosCobrados { get; set; } = [];
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 6 };

    // Filtros: se aplican al presionar "Filtrar". Por defecto el veterinario ve las suyas
    private string Filtro { get; set; } = string.Empty;
    private DateTime? FechaFiltro { get; set; }
    private bool SoloMias { get; set; } = true;

    // GET /atenciones y GET /recetas (para "Ver receta" o "Emitir receta"). Las boletas (GET /boletas) solo
    // sirven para avisar de antemano que una atención con insumos ya cobrados no se puede anular; si no cargan,
    // la pantalla funciona igual y el backend decide al anular.
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Task<List<AtencionViewModel>> atenciones = AtencionService.FindAll();
            Task<List<RecetaViewModel>> recetas = RecetaService.FindAll();
            Todas = (await atenciones).OrderByDescending(a => a.FechaHora).ToList();
            Recetas = await recetas;
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
            Cargando = false;
            return;
        }
        Cargando = false;
        try {
            InsumosCobrados = (await BoletaService.FindAll())
                .SelectMany(b => b.Lineas)
                .Where(l => l.IdInsumoUtilizado != null)
                .Select(l => l.IdInsumoUtilizado!.Value)
                .ToHashSet();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            InsumosCobrados = [];
        }
    }

    private void Filtrar() {
        string texto = Filtro.Trim();
        Atenciones = Todas
            .Where(a => a.NombreMascota.Contains(texto, StringComparison.OrdinalIgnoreCase)
                     || a.NombreCliente.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .Where(a => FechaFiltro == null || a.FechaHora?.Date == FechaFiltro.Value.Date)
            .Where(a => !SoloMias || a.IdVeterinario == Sesion.IdPersona)
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        FechaFiltro = null;
        SoloMias = true;
        Filtrar();
    }

    private RecetaViewModel? RecetaDe(AtencionViewModel atencion) {
        return Recetas.FirstOrDefault(r => r.IdAtencion == atencion.Id);
    }

    private bool PuedeAnularse(AtencionViewModel atencion) {
        return RecetaDe(atencion) == null
            && !atencion.Insumos.Any(i => InsumosCobrados.Contains(i.Id));
    }

    private void EditarAtencion(int id) {
        Nav.NavigateTo($"/atenciones/editar/{id}");
    }

    private void NuevaReceta(int idAtencion) {
        Nav.NavigateTo($"/recetas/nueva/{idAtencion}");
    }

    private void VerReceta(int idReceta) {
        Nav.NavigateTo($"/recetas/{idReceta}");
    }

    private void VerHistorial(int idMascota) {
        Nav.NavigateTo($"/reportes/historial-clinico/{idMascota}");
    }

    private void PedirAnulacion(AtencionViewModel atencion) {
        AtencionAAnular = atencion;
    }

    private void CancelarAnulacion() {
        AtencionAAnular = null;
    }

    // DELETE /atenciones/{id}: sus insumos vuelven al stock. Si el backend lo rechaza (tiene receta o insumos
    // ya cobrados) se muestra su mensaje
    private async Task AnularAtencion() {
        if (AtencionAAnular == null) {
            return;
        }
        AtencionViewModel atencion = AtencionAAnular;
        AtencionAAnular = null;
        MensajeExito = null;
        MensajeError = null;
        try {
            await AtencionService.Delete(atencion.Id);
            Todas.Remove(atencion);
            if (AtencionSeleccionada == atencion) {
                AtencionSeleccionada = null;
            }
            MensajeExito = $"Se anuló la atención de {atencion.NombreMascota} ({atencion.NombreServicio}).";
            Filtrar();
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
    }
}
