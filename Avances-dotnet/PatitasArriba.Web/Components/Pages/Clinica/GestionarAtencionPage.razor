@page "/atenciones/registrar/{IdDetalleCita:int}"
@page "/atenciones/editar/{Id:int}"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;
@inject IAtencionService AtencionService;
@inject ICitaService CitaService;
@inject IMascotaService MascotaService;
@inject IServicioService ServicioService;
@inject IDiagnosticoService DiagnosticoService;
@inject IArticuloService ArticuloService;

<PageTitle>Atención</PageTitle>

<h3 class="mb-3">@(Id == null ? "Registrar atención" : "Editar atención")</h3>

@if (MensajeError != null) {
    @* Por ejemplo: no hay stock suficiente de un insumo (RN-AT-08) *@
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando la atención...</p>
} else if (Listo) {
@* Paciente y servicio de la cita que se está atendiendo *@
<div class="card mb-4">
    <div class="card-body d-flex flex-wrap align-items-center gap-3">
        <AvatarMascota Nombre="@ViewModel.NombreMascota" Foto="@Mascota?.Foto" />
        <div class="flex-grow-1">
            <div class="fs-5 fw-bold">
                @ViewModel.NombreMascota · @ViewModel.NombreServicio
                @if (Cita?.EsEmergencia == true) {
                    <span class="badge text-bg-danger ms-1">Emergencia</span>
                }
            </div>
            <div class="text-muted">@DatosMascota</div>
            <div class="small text-muted">
                Dueño: @ViewModel.NombreCliente · Cita: @(Cita?.FechaHora?.ToString("dd/MM/yyyy HH:mm") ?? "—") · Veterinario: @ViewModel.NombreVeterinario
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-xl-8">
        <EditForm Model="ViewModel" OnValidSubmit="Guardar">
            <DataAnnotationsValidator />

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label class="form-label">Fecha y hora de la atención</label>
                    <PaInputDate tabindex="1" Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="ViewModel.FechaHora" />
                    <ValidationMessage For="() => ViewModel.FechaHora" />
                </div>
                <div class="col-md-8 mb-3">
                    <label class="form-label">Motivo de consulta @(ViewModel.EsServicioMedico ? "" : "(opcional)")</label>
                    <PaInputText tabindex="2" class="form-control" @bind-Value="ViewModel.MotivoConsulta" />
                    <ValidationMessage For="() => ViewModel.MotivoConsulta" />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label">Observaciones</label>
                <PaInputTextArea tabindex="3" class="form-control" rows="3" @bind-Value="ViewModel.Observaciones" />
                <ValidationMessage For="() => ViewModel.Observaciones" />
            </div>

            @* RN-AT-06: en servicios estéticos no se registran diagnósticos *@
            @if (ViewModel.EsServicioMedico) {
                <h5 class="mt-4">Diagnósticos</h5>
                <TablaDiagnosticos Diagnosticos="ViewModel.Diagnosticos" Catalogo="Diagnosticos" />
            }

            <h5 class="mt-4">Insumos utilizados</h5>
            <p class="form-text mt-0">Al guardar, los insumos se descuentan del stock (RN-AT-08). Marque "Se cobra aparte" si el cliente los paga en caja.</p>
            <TablaInsumos Insumos="ViewModel.Insumos" Articulos="Articulos" />

            <div class="d-flex gap-2 mt-4">
                <button tabindex="4" type="submit" class="btn btn-primary btn-texto" disabled="@Guardando"><Icono Nombre="save" /><span>@(Guardando ? "Guardando..." : "Guardar")</span></button>
                <a tabindex="5" class="btn btn-outline-primary" href="@(Id == null ? "mi-agenda" : "atenciones")">Cancelar</a>
            </div>
        </EditForm>
    </div>

    @* Lo último que se le hizo a la mascota, para consultarlo sin salir del formulario *@
    <div class="col-xl-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Últimas atenciones</span>
                <a class="small fw-bold" href="@($"reportes/historial-clinico/{ViewModel.IdMascota}")" target="_blank">Historial completo</a>
            </div>
            <div class="card-body py-2">
                @if (Anteriores.Count == 0) {
                    <p class="text-muted my-2">Es la primera atención de @(ViewModel.NombreMascota).</p>
                }
                @foreach (AtencionViewModel anterior in Anteriores) {
                    <div class="fila-pendiente">
                        <div>
                            <strong>@(anterior.FechaHora?.ToString("dd/MM/yyyy"))</strong> · @anterior.NombreServicio
                            <div class="small text-muted">@anterior.NombreVeterinario</div>
                            @if (!string.IsNullOrWhiteSpace(anterior.MotivoConsulta)) {
                                <div class="small">Motivo: @anterior.MotivoConsulta</div>
                            }
                            @if (anterior.Diagnosticos.Count > 0) {
                                <div class="d-flex flex-wrap gap-1 mt-1">
                                    @foreach (AtencionDiagnosticoViewModel diagnostico in anterior.Diagnosticos) {
                                        <span class="chip-cat">@diagnostico.NombreEnfermedad (@(TextoEnum.De(diagnostico.NivelGravedad).ToLower()))</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
}

@code {
    // Registrar: viene el servicio de la cita (detalle_cita) desde la agenda
    [Parameter]
    public int? IdDetalleCita { get; set; }

    // Editar: viene la atención ya registrada
    [Parameter]
    public int? Id { get; set; }

    private AtencionViewModel ViewModel { get; set; } = new();
    private List<DiagnosticoViewModel> Diagnosticos { get; set; } = [];
    private List<ArticuloViewModel> Articulos { get; set; } = [];

    // Datos para el encabezado y el panel lateral
    private MascotaViewModel? Mascota { get; set; }
    private CitaViewModel? Cita { get; set; }
    private List<AtencionViewModel> Anteriores { get; set; } = [];

    private string DatosMascota {
        get {
            if (Mascota == null) {
                return "";
            }
            string peso = Mascota.Peso is > 0 ? $"{Mascota.Peso:N1} kg" : "Peso sin registrar";
            string edad = Mascota.FechaNacimiento == null ? "" : " · " + PortalCliente.Edad(Mascota.FechaNacimiento);
            return $"{TextoEnum.De(Mascota.TipoMascota)} · {Mascota.Raza ?? "Sin raza"} · {peso}{edad}";
        }
    }

    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private bool Guardando { get; set; }

    // Hay datos para mostrar el formulario (si no se pudo cargar, solo queda el mensaje de error)
    private bool Listo { get; set; }

    // GET /diagnosticos y /articulos para las tablas; la atención o el servicio de la cita a atender;
    // y para el encabezado y el panel lateral, la mascota y su historial
    protected override async Task OnParametersSetAsync() {
        MensajeError = null;
        Cargando = true;
        Listo = false;
        if (!RendererInfo.IsInteractive) return;
        try {
            Task<List<DiagnosticoViewModel>> diagnosticos = DiagnosticoService.FindAll();
            Task<List<ArticuloViewModel>> articulos = ArticuloService.FindAll();
            // Una atención apunta a un servicio de una cita, y no hay consulta por servicio: se buscan entre todas
            Task<List<CitaViewModel>> citas = CitaService.FindAll();
            Diagnosticos = await diagnosticos;
            Articulos = await articulos;
            List<CitaViewModel> todasLasCitas = await citas;

            if (Id != null) {
                // GET /atenciones/{Id}
                AtencionViewModel? atencion = await AtencionService.FindById(Id.Value);
                if (atencion == null) {
                    Nav.NavigateTo("/atenciones");
                    return;
                }
                ViewModel = atencion;
            } else if (!await PrepararNueva(todasLasCitas)) {
                Nav.NavigateTo("/mi-agenda");
                return;
            }

            Cita = todasLasCitas.FirstOrDefault(c => c.Detalles.Any(d => d.Id == ViewModel.IdDetalleCita));
            Task<MascotaViewModel?> mascota = MascotaService.FindById(ViewModel.IdMascota);
            Task<List<AtencionViewModel>> historial = AtencionService.FindByMascota(ViewModel.IdMascota);
            Mascota = await mascota;
            Anteriores = (await historial)
                .Where(a => a.Id != ViewModel.Id)
                .OrderByDescending(a => a.FechaHora)
                .Take(3)
                .ToList();
            Listo = true;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // Registrar: el servicio de la cita sale de la agenda de su fecha (la cita puede ser de otro día, por ejemplo
    // una emergencia de ayer). Solo se atiende lo que la agenda permite: cita aprobada (o emergencia pendiente),
    // desde su hora y una sola vez. Devuelve false si no se puede atender.
    private async Task<bool> PrepararNueva(List<CitaViewModel> todasLasCitas) {
        CitaViewModel? cita = todasLasCitas.FirstOrDefault(c => c.Detalles.Any(d => d.Id == IdDetalleCita));
        if (cita?.FechaHora == null) {
            return false;
        }
        Task<List<ServicioViewModel>> servicios = ServicioService.FindAll();
        Task<Dictionary<int, int>> atenciones = AtencionService.AtencionPorDetalleCita();
        ItemAgendaViewModel? item = AgendaClinica.DelDia(cita.FechaHora.Value, [cita], await servicios)
            .FirstOrDefault(i => i.IdDetalleCita == IdDetalleCita);
        HashSet<int> atendidos = (await atenciones).Keys.ToHashSet();
        if (item == null || !AgendaVeterinario.PuedeAtenderse(item, atendidos, DateTime.Now)) {
            return false;
        }
        ViewModel = new AtencionViewModel {
            IdDetalleCita = item.IdDetalleCita,
            IdMascota = item.IdMascota,
            NombreMascota = item.NombreMascota,
            NombreCliente = item.NombreCliente,
            NombreServicio = item.NombreServicio,
            TipoServicio = item.TipoServicio,
            IdVeterinario = item.IdVeterinario,
            NombreVeterinario = item.NombreVeterinario,
            FechaHora = DateTime.Now
        };
        return true;
    }

    // POST /atenciones o PUT /atenciones/{Id}. Si no hay stock suficiente de algún insumo, el backend no registra
    // la atención (RN-AT-08) y se muestra su mensaje. Al registrar se vuelve a la agenda del veterinario.
    private async Task Guardar() {
        if (Guardando) return;
        MensajeError = null;
        Guardando = true;
        // RN-AT-06: en un servicio estético no hay diagnósticos (el formulario no los muestra). Si la atención trae
        // alguno de antes, se quita: si se reenviara, el backend rechazaría el cambio y no se podría editar.
        if (!ViewModel.EsServicioMedico) {
            ViewModel.Diagnosticos.Clear();
        }
        try {
            if (Id == null) {
                await AtencionService.Insert(ViewModel);
                Nav.NavigateTo(Sesion.Rol == RolUsuario.VETERINARIO ? "/mi-agenda" : "/atenciones");
            } else {
                await AtencionService.Update(ViewModel);
                Nav.NavigateTo("/atenciones");
            }
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
