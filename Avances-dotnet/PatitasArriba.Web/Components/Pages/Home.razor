@page "/"
@inject SesionDemo Sesion;

<PageTitle>Inicio · Patitas Arriba</PageTitle>

@* Cada rol ve su propio panel; sin sesión se muestra la portada *@
@switch (Sesion.Rol) {
    case RolUsuario.ADMINISTRADOR:
        <PanelAdministrador Nombre="@Sesion.NombreUsuario" />
        break;
    case RolUsuario.VETERINARIO:
        <PanelVeterinario Nombre="@Sesion.NombreUsuario" />
        break;
    case RolUsuario.CLIENTE:
        <PanelCliente Nombre="@Sesion.NombreUsuario" />
        break;
    default:
        <InicioPublico />
        break;
}
