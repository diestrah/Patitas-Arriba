@page "/diagnosticos/nuevo"
@page "/diagnosticos/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Diagnósticos</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nuevo diagnóstico" : "Editar diagnóstico")</h3>

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre de la enfermedad</label>
            <InputText tabindex="1" class="form-control" @bind-Value="ViewModel.NombreEnfermedad" />
            <ValidationMessage For="() => ViewModel.NombreEnfermedad" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputTextArea tabindex="2" class="form-control" rows="3" @bind-Value="ViewModel.Descripcion" />
            <ValidationMessage For="() => ViewModel.Descripcion" />
        </div>

        <button tabindex="4" type="submit" class="btn btn-primary">Guardar</button>
        <a tabindex="5" class="btn btn-outline-secondary" href="diagnosticos">Cancelar</a>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private DiagnosticoViewModel ViewModel { get; set; } = new();

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new DiagnosticoViewModel();
            return;
        }
        DiagnosticoViewModel? diagnostico = DatosEjemplo.Diagnosticos().FirstOrDefault(d => d.Id == Id);
        if (diagnostico == null) {
            Nav.NavigateTo("/diagnosticos");
            return;
        }
        ViewModel = diagnostico;
    }

    private void Guardar() {
        Nav.NavigateTo("/diagnosticos");
    }
}
