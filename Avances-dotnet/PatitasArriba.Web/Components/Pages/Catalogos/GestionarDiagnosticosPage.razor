@page "/diagnosticos/nuevo"
@page "/diagnosticos/editar/{Id:int}"
@attribute [Authorize(Policy = "Diagnosticos")]
@inject NavigationManager Nav;
@inject IDiagnosticoService DiagnosticoService;

<PageTitle>Diagnósticos</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nuevo diagnóstico" : "Editar diagnóstico")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    @if (Cargando) {
        <p class="text-muted">Cargando diagnóstico...</p>
    } else {
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Nombre de la enfermedad</label>
            <PaInputText tabindex="1" class="form-control" @bind-Value="ViewModel.NombreEnfermedad" />
            <ValidationMessage For="() => ViewModel.NombreEnfermedad" />
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <PaInputTextArea tabindex="2" class="form-control" rows="3" @bind-Value="ViewModel.Descripcion" />
            <ValidationMessage For="() => ViewModel.Descripcion" />
        </div>

        <div class="d-flex gap-2">
            <button tabindex="4" type="submit" class="btn btn-primary btn-texto" disabled="@Guardando"><Icono Nombre="save" /><span>@(Guardando ? "Guardando..." : "Guardar")</span></button>
            <a tabindex="5" class="btn btn-outline-primary" href="diagnosticos">Cancelar</a>
        </div>
    </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private DiagnosticoViewModel ViewModel { get; set; } = new();
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; }
    private bool Guardando { get; set; }

    // Al editar: GET /diagnosticos/{Id}; si no existe se vuelve al listado
    protected override async Task OnParametersSetAsync() {
        MensajeError = null;
        if (Id == null) {
            ViewModel = new DiagnosticoViewModel();
            return;
        }
        Cargando = true;
        if (!RendererInfo.IsInteractive) return;
        try {
            DiagnosticoViewModel? diagnostico = await DiagnosticoService.FindById(Id.Value);
            if (diagnostico == null) {
                Nav.NavigateTo("/diagnosticos");
                return;
            }
            ViewModel = diagnostico;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // POST /diagnosticos o PUT /diagnosticos/{Id}; si el backend rechaza los datos se muestra su mensaje
    private async Task Guardar() {
        if (Guardando) return;
        MensajeError = null;
        Guardando = true;
        try {
            if (Id == null) {
                await DiagnosticoService.Insert(ViewModel);
            } else {
                await DiagnosticoService.Update(ViewModel);
            }
            Nav.NavigateTo("/diagnosticos");
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
