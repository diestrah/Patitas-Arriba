@page "/servicios"
@inject NavigationManager Nav;
@inject SesionDemo Sesion;

@using Microsoft.AspNetCore.Components.QuickGrid

<PageTitle>Servicios</PageTitle>

<div class="d-flex justify-content-between mb-3">
    <h3 class="mb-3">Catálogo de servicios</h3>
    @* El veterinario solo consulta: no ve los botones para registrar, editar ni eliminar *@
    @if (Sesion.EsAdministrador) {
        <button tabindex="4" class="btn btn-warning btn-texto" @onclick="() => NuevoServicio()">
            <Icono Nombre="plus" /><span>Nuevo servicio</span>
        </button>
    }
</div>

<div class="barra-filtros d-flex align-items-center gap-2 mb-3">
    <label class="text-nowrap">Nombre:</label>
    <input tabindex="1" class="form-control" placeholder="Ingrese el nombre..." @bind="Filtro" />
    <button tabindex="2" class="btn btn-primary btn-texto" @onclick="() => Filtrar()">
        <Icono Nombre="search" /><span>Filtrar</span>
    </button>
    <button tabindex="3" class="btn btn-secondary" @onclick="() => LimpiarFiltro()">Limpiar</button>
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}

@if (!Servicios.Any()) {
    <div class="alert alert-info">No se encontraron servicios.</div>
}
else {
    <QuickGrid Items="Servicios" Pagination="Paginacion" Class="table table-striped table-hover align-middle">
        <PropertyColumn Title="Nombre" Property="s => s.Nombre" Sortable="true" />
        <PropertyColumn Title="Tipo" Property="s => TextoEnum.De(s.TipoServicio)" />
        <PropertyColumn Title="Descripción" Property="s => s.Descripcion" />
        <PropertyColumn Title="Duración (min)" Property="s => s.DuracionEstimada" Align="Align.Right" />
        <PropertyColumn Title="Precio (S/)" Property="s => s.PrecioBase" Format="N2"
                        Sortable="true" Align="Align.Right" />
        @if (Sesion.EsAdministrador) {
            <TemplateColumn Title="Acciones" Align="Align.Center">
                <div class="acciones">
                    <button class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" @onclick="() => EditarServicio(context.Id)">
                        <Icono Nombre="edit" />
                    </button>
                    <button class="btn btn-outline-danger btn-icono" title="Eliminar" aria-label="Eliminar" @onclick="() => PedirEliminar(context)">
                        <Icono Nombre="trash" />
                    </button>
                </div>
            </TemplateColumn>
        }
    </QuickGrid>
    <Paginador State="Paginacion" />
}

<ConfirmarDialogo Visible="ServicioAEliminar != null"
                  Titulo="¿Eliminar el servicio?"
                  Mensaje="@($"“{ServicioAEliminar?.Nombre}” dejará de aparecer en el catálogo. No se puede si está incluido en alguna cita.")"
                  OnConfirmar="EliminarServicio" OnCancelar="CancelarEliminacion" />

@code {
    private List<ServicioViewModel> Todos { get; set; } = [];
    private IQueryable<ServicioViewModel> Servicios { get; set; } = Enumerable.Empty<ServicioViewModel>().AsQueryable();
    private ServicioViewModel? ServicioAEliminar { get; set; }
    private string? MensajeExito { get; set; }
    private string Filtro { get; set; } = string.Empty;
    private PaginationState Paginacion { get; } = new() { ItemsPerPage = 7 };

    protected override void OnInitialized() {
        Todos = DatosEjemplo.Servicios();
        Filtrar();
    }

    // Al enlazar: GET /servicios?nombre=...
    private void Filtrar() {
        string texto = Filtro.Trim();
        Servicios = Todos
            .Where(s => s.Nombre.Contains(texto, StringComparison.OrdinalIgnoreCase))
            .AsQueryable();
    }

    private void LimpiarFiltro() {
        Filtro = string.Empty;
        Filtrar();
    }

    private void NuevoServicio() {
        Nav.NavigateTo("/servicios/nuevo");
    }

    private void EditarServicio(int id) {
        Nav.NavigateTo($"/servicios/editar/{id}");
    }

    private void PedirEliminar(ServicioViewModel servicio) {
        ServicioAEliminar = servicio;
    }

    private void CancelarEliminacion() {
        ServicioAEliminar = null;
    }

    // Sin backend: se quita de la lista. Al enlazar se llamará a DELETE /servicios/{id};
    // si el backend lo rechaza (RN-SE-05), se mostrará su mensaje.
    private void EliminarServicio() {
        if (ServicioAEliminar == null) {
            return;
        }
        Todos.Remove(ServicioAEliminar);
        MensajeExito = $"Se eliminó el servicio “{ServicioAEliminar.Nombre}”.";
        ServicioAEliminar = null;
        Filtrar();
    }
}
