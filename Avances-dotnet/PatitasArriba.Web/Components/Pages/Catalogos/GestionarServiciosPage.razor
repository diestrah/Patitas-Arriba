@page "/servicios/nuevo"
@page "/servicios/editar/{Id:int}"
@inject NavigationManager Nav;

<PageTitle>Servicios</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nuevo servicio" : "Editar servicio")</h3>

    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <InputText tabindex="1" class="form-control" @bind-Value="ViewModel.Nombre" />
            <ValidationMessage For="() => ViewModel.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Tipo de servicio</label>
            <InputSelect tabindex="2" class="form-select" @bind-Value="ViewModel.TipoServicio">
                @foreach (TipoServicio tipo in Tipos) {
                    <option value="@tipo">@TextoEnum.De(tipo)</option>
                }
            </InputSelect>
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <InputTextArea tabindex="3" class="form-control" rows="3" @bind-Value="ViewModel.Descripcion" />
            <ValidationMessage For="() => ViewModel.Descripcion" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Precio (S/)</label>
                <InputNumber tabindex="4" class="form-control" @bind-Value="ViewModel.PrecioBase" />
                <ValidationMessage For="() => ViewModel.PrecioBase" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Duración estimada (minutos)</label>
                <InputNumber tabindex="5" class="form-control" @bind-Value="ViewModel.DuracionEstimada" />
                <ValidationMessage For="() => ViewModel.DuracionEstimada" />
            </div>
        </div>

        <button tabindex="7" type="submit" class="btn btn-primary">Guardar</button>
        <a tabindex="8" class="btn btn-outline-secondary" href="servicios">Cancelar</a>
    </EditForm>
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ServicioViewModel ViewModel { get; set; } = new();
    private TipoServicio[] Tipos { get; } = Enum.GetValues<TipoServicio>();

    protected override void OnParametersSet() {
        if (Id == null) {
            ViewModel = new ServicioViewModel();
            return;
        }
        ServicioViewModel? servicio = DatosEjemplo.Servicios().FirstOrDefault(s => s.Id == Id);
        if (servicio == null) {
            Nav.NavigateTo("/servicios");
            return;
        }
        ViewModel = servicio;
    }

    private void Guardar() {
        Nav.NavigateTo("/servicios");
    }
}
