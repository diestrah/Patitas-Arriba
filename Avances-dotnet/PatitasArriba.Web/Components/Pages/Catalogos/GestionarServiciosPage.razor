@page "/servicios/nuevo"
@page "/servicios/editar/{Id:int}"
@inject NavigationManager Nav;
@inject IServicioService ServicioService;

<PageTitle>Servicios</PageTitle>

<div class="col-md-7">
    <h3 class="mb-3">@(Id == null ? "Nuevo servicio" : "Editar servicio")</h3>

    @if (MensajeError != null) {
        <div class="alert alert-danger">@MensajeError</div>
    }

    @if (Cargando) {
        <p class="text-muted">Cargando servicio...</p>
    } else {
    <EditForm Model="ViewModel" OnValidSubmit="Guardar">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Nombre</label>
            <PaInputText tabindex="1" class="form-control" @bind-Value="ViewModel.Nombre" />
            <ValidationMessage For="() => ViewModel.Nombre" />
        </div>
        <div class="mb-3">
            <label class="form-label">Tipo de servicio</label>
            <PaInputSelect tabindex="2" class="form-select" @bind-Value="ViewModel.TipoServicio">
                @foreach (TipoServicio tipo in Tipos) {
                    <option value="@tipo">@TextoEnum.De(tipo)</option>
                }
            </PaInputSelect>
        </div>
        <div class="mb-3">
            <label class="form-label">Descripción</label>
            <PaInputTextArea tabindex="3" class="form-control" rows="3" @bind-Value="ViewModel.Descripcion" />
            <ValidationMessage For="() => ViewModel.Descripcion" />
        </div>
        <div class="row">
            <div class="col-md-6 mb-3">
                <label class="form-label">Precio (S/)</label>
                <PaInputNumber tabindex="4" class="form-control" @bind-Value="ViewModel.PrecioBase" />
                <ValidationMessage For="() => ViewModel.PrecioBase" />
            </div>
            <div class="col-md-6 mb-3">
                <label class="form-label">Duración estimada (minutos)</label>
                <PaInputNumber tabindex="5" class="form-control" @bind-Value="ViewModel.DuracionEstimada" />
                <div class="form-text">Opcional. Si se deja vacía, la agenda usa 30 minutos.</div>
                <ValidationMessage For="() => ViewModel.DuracionEstimada" />
            </div>
        </div>

        <div class="d-flex gap-2">
            <button tabindex="7" type="submit" class="btn btn-primary btn-texto" disabled="@Guardando"><Icono Nombre="save" /><span>@(Guardando ? "Guardando..." : "Guardar")</span></button>
            <a tabindex="8" class="btn btn-outline-primary" href="servicios">Cancelar</a>
        </div>
    </EditForm>
    }
</div>

@code {
    [Parameter]
    public int? Id { get; set; }

    private ServicioViewModel ViewModel { get; set; } = new();
    private TipoServicio[] Tipos { get; } = Enum.GetValues<TipoServicio>();
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; }
    private bool Guardando { get; set; }

    // Al editar: GET /servicios/{Id}; si no existe se vuelve al listado
    protected override async Task OnParametersSetAsync() {
        MensajeError = null;
        if (Id == null) {
            ViewModel = new ServicioViewModel();
            return;
        }
        Cargando = true;
        if (!RendererInfo.IsInteractive) return;
        try {
            ServicioViewModel? servicio = await ServicioService.FindById(Id.Value);
            if (servicio == null) {
                Nav.NavigateTo("/servicios");
                return;
            }
            ViewModel = servicio;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    // POST /servicios o PUT /servicios/{Id}; si el backend rechaza los datos se muestra su mensaje
    private async Task Guardar() {
        if (Guardando) return;
        MensajeError = null;
        Guardando = true;
        try {
            if (Id == null) {
                await ServicioService.Insert(ViewModel);
            } else {
                await ServicioService.Update(ViewModel);
            }
            Nav.NavigateTo("/servicios");
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Guardando = false;
        }
    }
}
