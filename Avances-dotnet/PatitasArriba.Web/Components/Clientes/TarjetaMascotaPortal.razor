@* Tarjeta de una mascota en el portal del cliente (inicio y Mis mascotas): datos básicos, última cita completada,
   próxima cita, botón para editar y botón para reservar una cita. *@
<div class="card h-100">
    <div class="card-body d-flex flex-column gap-2">
        <div class="d-flex justify-content-between align-items-start gap-2">
            <div class="d-flex align-items-center gap-3">
                <AvatarMascota Nombre="@Mascota.Nombre" Foto="@Mascota.Foto" />
                <div>
                    <h5 class="mb-0">@Mascota.Nombre</h5>
                    <div class="small text-muted">@TextoEnum.De(Mascota.TipoMascota) · @(string.IsNullOrWhiteSpace(Mascota.Raza) ? "Sin raza" : Mascota.Raza) · @TextoEnum.De(Mascota.Sexo)</div>
                </div>
            </div>
            <a class="btn btn-outline-primary btn-icono" href="@($"mis-mascotas/editar/{Mascota.Id}")" title="Editar" aria-label="@($"Editar a {Mascota.Nombre}")">
                <Icono Nombre="edit" />
            </a>
        </div>
        <dl class="datos-mascota mb-0">
            <dt>Peso y edad</dt>
            <dd>@(Mascota.Peso is > 0 ? $"{Mascota.Peso:N1} kg" : "Peso sin registrar")@(Mascota.FechaNacimiento == null ? "" : " · " + PortalCliente.Edad(Mascota.FechaNacimiento))</dd>
            <dt>Última cita completada</dt>
            <dd>@(Ultima == null ? "Sin citas completadas" : $"{Ultima.FechaHora:dd/MM/yyyy} · {Ultima.TextoServicios}")</dd>
            <dt>Próxima cita</dt>
            <dd>@(Proxima == null ? "Ninguna" : $"{Proxima.FechaHora:dd/MM · HH:mm} · {TextoEnum.De(Proxima.Estado)}")</dd>
        </dl>
        <a class="btn btn-primary btn-texto align-self-start mt-auto" href="@($"mis-citas/nueva?mascota={Mascota.Id}")">
            <Icono Nombre="calendar" /><span>Reservar para @Mascota.Nombre</span>
        </a>
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public MascotaViewModel Mascota { get; set; } = default!;

    // Citas del cliente: de ahí salen la última cita completada y la próxima
    [Parameter, EditorRequired]
    public List<CitaViewModel> Citas { get; set; } = [];

    private CitaViewModel? Ultima => PortalCliente.UltimaCompletada(Citas, Mascota.Id);
    private CitaViewModel? Proxima => PortalCliente.ProximaDe(Citas, Mascota.Id);
}
