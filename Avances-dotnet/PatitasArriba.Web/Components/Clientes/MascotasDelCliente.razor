<div class="card">
    <div class="card-header fw-bold">
        @Cliente.NombreCompleto
    </div>
    <div class="card-body">
        <p class="small mb-3">
            DNI: @Cliente.Dni · Teléfono: @Cliente.Telefono
        </p>

        <h6 class="mb-2">Mascotas (@Mascotas.Count)</h6>

        @if (Mascotas.Count == 0) {
            <div class="alert alert-info mb-0">El cliente no tiene mascotas registradas.</div>
        }
        else {
            <div class="row g-2">
                @foreach (MascotaViewModel mascota in Mascotas) {
                    <div class="col-12">
                        <TarjetaMascota Mascota="mascota">
                            <a class="btn btn-secondary btn-sm btn-texto" href="@($"reportes/historial-clinico/{mascota.Id}")">
                                <Icono Nombre="clipboard" /><span>Historial</span>
                            </a>
                            @if (PermitirEditar) {
                                <a class="btn btn-outline-primary btn-icono" title="Editar" aria-label="Editar" href="@($"mascotas/editar/{mascota.Id}")">
                                    <Icono Nombre="edit" />
                                </a>
                            }
                        </TarjetaMascota>
                    </div>
                }
            </div>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public ClienteViewModel Cliente { get; set; } = default!;

    [Parameter, EditorRequired]
    public List<MascotaViewModel> Mascotas { get; set; } = default!;

    [Parameter]
    public bool PermitirEditar { get; set; }
}
