@inject SesionDemo Sesion;
@inject ICitaService CitaService;
@inject IArticuloService ArticuloService;
@inject IAtencionService AtencionService;
@inject IVeterinarioService VeterinarioService;
@inject IBoletaService BoletaService;
@inject IServicioService ServicioService;

@using System.Globalization

<BannerInicio Nombre="@Sesion.Nombres" Texto="@Resumen">
    <div class="d-flex flex-wrap gap-2">
        <a class="btn btn-warning btn-texto" href="citas/nueva"><Icono Nombre="plus" /><span>Nueva cita</span></a>
        <a class="btn btn-secondary btn-texto" href="clientes/nuevo"><Icono Nombre="users" /><span>Nuevo cliente</span></a>
        <a class="btn btn-secondary btn-texto" href="mascotas/nuevo"><Icono Nombre="paw" /><span>Nueva mascota</span></a>
        <a class="btn btn-secondary btn-texto" href="agenda"><Icono Nombre="calendar" /><span>Agenda diaria</span></a>
    </div>
</BannerInicio>

@if (MensajeError != null) {
    <div class="alert alert-danger">@MensajeError</div>
}

@if (Cargando) {
    <p class="text-muted">Cargando el resumen del día...</p>
} else {
<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a class="indicador indicador-verde" href="agenda">
            <span class="indicador-icono"><Icono Nombre="calendar" /></span>
            <span class="indicador-valor">@CitasDeHoy</span>
            <span class="indicador-texto">Citas de hoy</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="indicador indicador-mostaza" href="citas">
            <span class="indicador-icono"><Icono Nombre="clock" /></span>
            <span class="indicador-valor">@PorAprobar.Count</span>
            <span class="indicador-texto">Citas por aprobar</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="indicador indicador-terracota" href="articulos">
            <span class="indicador-icono"><Icono Nombre="alert" /></span>
            <span class="indicador-valor">@StockBajo.Count</span>
            <span class="indicador-texto">Artículos con stock bajo</span>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a class="indicador indicador-salvia" href="boletas">
            <span class="indicador-icono"><Icono Nombre="wallet" /></span>
            <span class="indicador-valor">S/ @CobradoHoy.ToString("N2")</span>
            <span class="indicador-texto">Cobrado hoy</span>
        </a>
    </div>
</div>

@if (MensajeExito != null) {
    <div class="alert alert-success">@MensajeExito</div>
}

<div class="row g-4">
    <div class="col-lg-7 d-flex flex-column gap-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Citas por aprobar</span>
                <a class="small fw-bold" href="citas">Ver todas las citas</a>
            </div>
            <div class="card-body py-2">
                @if (PorAprobar.Count == 0) {
                    <p class="text-muted my-2">No hay citas por aprobar.</p>
                }
                @foreach (CitaViewModel cita in PorAprobar) {
                    <div class="fila-pendiente">
                        <div>
                            <strong>@cita.NombreMascota</strong> · @cita.TextoServicios
                            @if (cita.EsEmergencia) {
                                <span class="badge text-bg-danger ms-1">Emergencia</span>
                            }
                            <div class="small text-muted">
                                @TextoDia(cita.FechaHora) @cita.FechaHora?.ToString("HH:mm") · Dueño: @cita.NombreCliente · @string.Join(", ", cita.Detalles.Select(d => d.NombreVeterinario).Distinct())
                            </div>
                        </div>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary btn-sm btn-texto" @onclick="() => Aprobar(cita)">
                                <Icono Nombre="check" /><span>Aprobar</span>
                            </button>
                            <button class="btn btn-outline-danger btn-sm btn-texto" @onclick="() => CitaARechazar = cita">
                                <Icono Nombre="x" /><span>Rechazar</span>
                            </button>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
                <span class="fw-bold">Agenda de hoy</span>
                <div class="d-flex align-items-center gap-3">
                    <select class="form-select form-select-sm w-auto" aria-label="Filtrar por veterinario" @bind="FiltroVeterinario">
                        <option value="Todos">Todos los veterinarios</option>
                        @foreach (string nombre in Veterinarios) {
                            <option value="@nombre">@nombre</option>
                        }
                    </select>
                    <a class="small fw-bold" href="agenda">Ver agenda completa</a>
                </div>
            </div>
            <div class="card-body">
                @if (AgendaFiltrada.Count == 0) {
                    <p class="text-muted mb-0">No hay servicios para este filtro.</p>
                } else {
                    <ul class="lista-agenda">
                        @foreach (ItemAgendaViewModel item in AgendaFiltrada) {
                            EstadoServicioAgenda estado = AgendaTexto.De(item, Atendidos);
                            <li>
                                <span class="lista-hora">@item.FechaHora.ToString("HH:mm")</span>
                                <div class="flex-grow-1">
                                    <div class="fw-bold">
                                        @item.NombreMascota · @item.NombreServicio
                                        @if (item.EsEmergencia) {
                                            <span class="badge text-bg-danger ms-1">Emergencia</span>
                                        }
                                    </div>
                                    <div class="small text-muted">@item.NombreCliente · @item.NombreVeterinario</div>
                                </div>
                                <span class="estado @AgendaTexto.ClaseEstado(estado)">@AgendaTexto.Texto(estado)</span>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-5 d-flex flex-column gap-4">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">Stock bajo</span>
                <a class="small fw-bold" href="articulos">Ver inventario</a>
            </div>
            <div class="card-body d-flex flex-column gap-3">
                @if (StockBajo.Count == 0) {
                    <span class="text-muted">Todo el inventario está sobre el mínimo.</span>
                }
                @foreach (ArticuloViewModel articulo in StockBajo) {
                    <div>
                        <div class="d-flex justify-content-between align-items-center gap-2">
                            <strong>@articulo.Nombre</strong>
                            <span class="d-flex align-items-center gap-3">
                                <a class="small fw-bold" href="@($"articulos/stock/{articulo.Id}")">Actualizar stock</a>
                                <strong class="stock-bajo">@articulo.StockActual de @articulo.StockMinimo</strong>
                            </span>
                        </div>
                        <div class="barra-progreso mt-1" role="img" aria-label="@($"{articulo.StockActual} de {articulo.StockMinimo}")">
                            <i style="@($"width:{PorcentajeStock(articulo)}%;background:var(--pa-terracota)")"></i>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="card">
            <div class="card-header fw-bold">Cobrado hoy</div>
            <div class="card-body d-flex flex-column gap-2">
                <div class="fs-2 fw-bold">S/ @CobradoHoy.ToString("N2")</div>
                <div class="small text-muted">@BoletasHoy boleta@(BoletasHoy == 1 ? "" : "s") emitida@(BoletasHoy == 1 ? "" : "s") hoy. Los servicios e insumos ya atendidos se cobran desde Nueva boleta, buscando al cliente por su DNI.</div>
                <div>
                    <a class="btn btn-primary btn-texto" href="boletas/nueva"><Icono Nombre="receipt" /><span>Nueva boleta</span></a>
                </div>
            </div>
        </div>
    </div>
</div>
}

<ConfirmarDialogo Visible="CitaARechazar != null"
                  Titulo="¿Rechazar la cita?"
                  Mensaje="@($"{CitaARechazar?.NombreMascota} · {CitaARechazar?.TextoServicios}. El cliente verá la cita como rechazada.")"
                  TextoConfirmar="Sí, rechazar"
                  TextoCancelar="No, volver"
                  IconoConfirmar="x"
                  OnConfirmar="Rechazar" OnCancelar="CancelarRechazo" />

@code {
    private static readonly CultureInfo Peru = new("es-PE");

    private List<CitaViewModel> Citas { get; set; } = [];
    private List<ArticuloViewModel> Articulos { get; set; } = [];
    private List<string> Veterinarios { get; set; } = [];
    private HashSet<int> Atendidos { get; set; } = [];
    private double CobradoHoy { get; set; }
    private int BoletasHoy { get; set; }

    private string FiltroVeterinario { get; set; } = "Todos";
    private CitaViewModel? CitaARechazar { get; set; }
    private string? MensajeExito { get; set; }
    private string? MensajeError { get; set; }
    private bool Cargando { get; set; } = true;
    private List<ServicioViewModel> Servicios { get; set; } = [];

    // Servicios programados para hoy (se recalcula al cargar y al aprobar o rechazar)
    private List<ItemAgendaViewModel> AgendaHoy { get; set; } = [];

    private List<CitaViewModel> PorAprobar => Citas.Where(c => c.Estado == EstadoCita.PENDIENTE).OrderBy(c => c.FechaHora).ToList();
    private List<ArticuloViewModel> StockBajo => Articulos.Where(a => a.StockBajo).ToList();
    private int CitasDeHoy => AgendaHoy.Select(i => i.IdCita).Distinct().Count();

    private List<ItemAgendaViewModel> AgendaFiltrada => AgendaHoy
        .Where(i => FiltroVeterinario == "Todos" || i.NombreVeterinario == FiltroVeterinario)
        .ToList();

    // Resumen en una frase: lo que el administrador debe atender primero
    private string Resumen {
        get {
            if (Cargando) {
                return "Preparando el resumen del día...";
            }
            int emergencias = PorAprobar.Count(c => c.EsEmergencia);
            string citas = $"Hoy tiene {PorAprobar.Count} cita{(PorAprobar.Count == 1 ? "" : "s")} por aprobar";
            if (emergencias > 0) {
                citas += emergencias == 1 ? " (una es emergencia)" : $" ({emergencias} son emergencias)";
            }
            return $"{citas} y {StockBajo.Count} artículo{(StockBajo.Count == 1 ? "" : "s")} por reponer.";
        }
    }

    // GET /citas (por aprobar y agenda de hoy), /servicios (duración en la agenda), /atenciones (lo ya atendido),
    // /articulos (stock bajo), /veterinarios (filtro de la agenda) y /boletas (lo cobrado hoy), en paralelo.
    // Solo en la pasada interactiva: así el prerenderizado no repite las consultas
    protected override async Task OnInitializedAsync() {
        if (!RendererInfo.IsInteractive) return;
        try {
            Task<List<CitaViewModel>> citas = CitaService.FindAll();
            Task<List<ServicioViewModel>> servicios = ServicioService.FindAll();
            Task<Dictionary<int, int>> atenciones = AtencionService.AtencionPorDetalleCita();
            Task<List<ArticuloViewModel>> articulos = ArticuloService.FindAll();
            Task<List<VeterinarioViewModel>> veterinarios = VeterinarioService.FindAll();
            Task<List<BoletaViewModel>> boletas = BoletaService.FindAll();

            Citas = await citas;
            Servicios = await servicios;
            Atendidos = (await atenciones).Keys.ToHashSet();
            Articulos = await articulos;
            Veterinarios = (await veterinarios).Select(v => v.NombreCompleto).ToList();
            AgendaHoy = AgendaClinica.DelDia(DateTime.Today, Citas, Servicios);

            // Lo cobrado hoy: solo boletas emitidas (las anuladas no cuentan)
            List<BoletaViewModel> deHoy = (await boletas).Where(b => b.IsActivo && b.Fecha.Date == DateTime.Today).ToList();
            BoletasHoy = deHoy.Count;
            CobradoHoy = deHoy.Sum(b => b.Total);
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        } finally {
            Cargando = false;
        }
    }

    private static int PorcentajeStock(ArticuloViewModel articulo) {
        return articulo.StockMinimo == 0 ? 0 : Math.Min(100, (int)Math.Round(100.0 * articulo.StockActual / articulo.StockMinimo));
    }

    private static string TextoDia(DateTime? fecha) {
        if (fecha == null) {
            return "";
        }
        if (fecha.Value.Date == DateTime.Today) {
            return "Hoy";
        }
        return fecha.Value.Date == DateTime.Today.AddDays(1) ? "Mañana" : fecha.Value.ToString("ddd d MMM", Peru);
    }

    // PUT /citas/{id} con el nuevo estado y el administrador que decide (RN-CI-09);
    // si el backend lo rechaza, la cita queda como estaba y se muestra su mensaje.
    private async Task CambiarEstado(CitaViewModel cita, EstadoCita estado, string mensaje) {
        MensajeExito = null;
        MensajeError = null;
        try {
            await CitaService.CambiarEstado(cita, estado, Sesion.IdPersona, Sesion.NombreUsuario);
            MensajeExito = mensaje;
        } catch (Exception ex) when (ErrorServicio.EsDeServicio(ex)) {
            MensajeError = ErrorServicio.Desde(ex);
        }
        AgendaHoy = AgendaClinica.DelDia(DateTime.Today, Citas, Servicios);
    }

    private Task Aprobar(CitaViewModel cita) =>
        CambiarEstado(cita, EstadoCita.APROBADO, $"Se aprobó la cita de {cita.NombreMascota}. Ahora aparece como \"Por atender\" en la agenda.");

    private async Task Rechazar() {
        if (CitaARechazar == null) {
            return;
        }
        CitaViewModel cita = CitaARechazar;
        CitaARechazar = null;
        await CambiarEstado(cita, EstadoCita.RECHAZADO, $"Se rechazó la cita de {cita.NombreMascota}.");
    }

    private void CancelarRechazo() {
        CitaARechazar = null;
    }
}
