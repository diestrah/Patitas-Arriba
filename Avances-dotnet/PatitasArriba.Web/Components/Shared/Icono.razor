@* Íconos de línea para los botones (mismo trazo que la muestra de botones de la paleta C).
   Uso: <Icono Nombre="edit" />. El color lo toma del botón (currentColor). *@
<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1"
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Nombre) {
        case "eye":
            <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
            <circle cx="12" cy="12" r="3" />
            break;
        case "edit":
            <path d="M12 20h9" />
            <path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z" />
            break;
        case "trash":
            <path d="M3 6h18" />
            <path d="M8 6V4h8v2" />
            <path d="M19 6l-1 14H6L5 6" />
            <path d="M10 11v6M14 11v6" />
            break;
        case "plus":
            <path d="M12 5v14M5 12h14" />
            break;
        case "x":
            <path d="M18 6 6 18M6 6l12 12" />
            break;
        case "check":
            <path d="M20 6 9 17l-5-5" />
            break;
        case "check-circle":
            <circle cx="12" cy="12" r="9" />
            <path d="m8 12 3 3 5-6" />
            break;
        case "save":
            <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z" />
            <path d="M17 21v-8H7v8M7 3v5h8" />
            break;
        case "search":
            <circle cx="11" cy="11" r="7" />
            <path d="m21 21-4.3-4.3" />
            break;
        case "box":
            <path d="M21 8 12 3 3 8v8l9 5 9-5z" />
            <path d="m3 8 9 5 9-5M12 13v8" />
            break;
        case "ban":
            <circle cx="12" cy="12" r="9" />
            <path d="m5.6 5.6 12.8 12.8" />
            break;
        case "lock":
            <rect x="3" y="11" width="18" height="11" rx="2" ry="2" />
            <path d="M7 11V7a5 5 0 0 1 10 0v4" />
            break;
        case "printer":
            <path d="M6 9V2h12v7" />
            <path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2" />
            <rect x="6" y="14" width="12" height="8" />
            break;
        case "file-text":
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6M16 13H8M16 17H8M10 9H8" />
            break;
        case "clipboard":
            <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2" />
            <rect x="8" y="2" width="8" height="4" rx="1" ry="1" />
            break;
        case "activity":
            <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
            break;
        case "arrow-left":
            <path d="M19 12H5M12 19l-7-7 7-7" />
            break;
        case "log-in":
            <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4" />
            <path d="M10 17l5-5-5-5M15 12H3" />
            break;
        case "log-out":
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
            <path d="M16 17l5-5-5-5M21 12H9" />
            break;
        case "arrow-right":
            <path d="M5 12h14M13 6l6 6-6 6" />
            break;
        case "calendar":
            <rect x="3" y="4" width="18" height="18" rx="2" />
            <path d="M16 2v4M8 2v4M3 10h18" />
            break;
        case "clock":
            <circle cx="12" cy="12" r="9" />
            <path d="M12 7v5l3 2" />
            break;
        case "users":
            <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M23 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            break;
        case "user":
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2" />
            <circle cx="12" cy="7" r="4" />
            break;
        case "paw":
            <ellipse cx="12" cy="16" rx="4.5" ry="3.8" />
            <ellipse cx="5.8" cy="10.5" rx="1.8" ry="2.4" />
            <ellipse cx="9.4" cy="6.2" rx="1.8" ry="2.4" />
            <ellipse cx="14.6" cy="6.2" rx="1.8" ry="2.4" />
            <ellipse cx="18.2" cy="10.5" rx="1.8" ry="2.4" />
            break;
        case "stethoscope":
            <path d="M5 3H4a1 1 0 0 0-1 1v5a5 5 0 0 0 10 0V4a1 1 0 0 0-1-1h-1" />
            <path d="M8 14v1a6 6 0 0 0 12 0v-3" />
            <circle cx="20" cy="10" r="2" />
            break;
        case "receipt":
            <path d="M4 2v20l2-1 2 1 2-1 2 1 2-1 2 1 2-1 2 1V2l-2 1-2-1-2 1-2-1-2 1-2-1-2 1Z" />
            <path d="M16 8h-6a2 2 0 1 0 0 4h4a2 2 0 1 1 0 4H8M12 18V6" />
            break;
        case "bar-chart":
            <path d="M12 20V10M18 20V4M6 20v-4" />
            break;
        case "alert":
            <path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4M12 17h.01" />
            break;
        case "tag":
            <path d="M20.6 13.4 13.4 20.6a2 2 0 0 1-2.8 0L2 12V2h10l8.6 8.6a2 2 0 0 1 0 2.8z" />
            <path d="M7 7h.01" />
            break;
        case "list":
            <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01" />
            break;
        case "key":
            <circle cx="7.5" cy="15.5" r="5.5" />
            <path d="m21 2-9.6 9.6M15.5 7.5l3 3L22 7l-3-3" />
            break;
        case "wallet":
            <path d="M20 12V8H6a2 2 0 0 1-2-2c0-1.1.9-2 2-2h12v4" />
            <path d="M4 6v12c0 1.1.9 2 2 2h14v-4" />
            <path d="M18 12a2 2 0 0 0 0 4h4v-4Z" />
            break;
        case "heart":
            <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21.2l7.8-7.7 1-1.1a5.5 5.5 0 0 0 0-7.8z" />
            break;
        case "info":
            <circle cx="12" cy="12" r="10" />
            <path d="M12 16v-4M12 8h.01" />
            break;
        case "mail":
            <rect x="3" y="5" width="18" height="14" rx="2" />
            <path d="m3 7 9 6 9-6" />
            break;
        case "home":
            <path d="m3 10 9-7 9 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
            <path d="M9 22V12h6v10" />
            break;
        case "chevron-left":
            <path d="m15 18-6-6 6-6" />
            break;
        case "chevron-right":
            <path d="m9 18 6-6-6-6" />
            break;
        case "chevrons-left":
            <path d="m11 17-5-5 5-5M18 17l-5-5 5-5" />
            break;
        case "chevrons-right":
            <path d="m13 17 5-5-5-5M6 17l5-5-5-5" />
            break;
    }
</svg>

@code {
    // Acciones: eye, edit, trash, plus, x, check, check-circle, save, search, box, ban, lock, printer,
    //   file-text, clipboard, activity, arrow-left, arrow-right, log-in, log-out
    // Menú e inicio: calendar, clock, users, user, paw, stethoscope, receipt, bar-chart, alert, tag, list,
    //   key, wallet, heart, info, mail, home
    // Paginador: chevron-left, chevron-right, chevrons-left, chevrons-right
    [Parameter, EditorRequired]
    public string Nombre { get; set; } = "";
}
