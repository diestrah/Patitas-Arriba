<span class="badge @ClaseColor">@TextoEnum.De(Estado)</span>

@code {
    [Parameter, EditorRequired]
    public EstadoCita Estado { get; set; }

    private string ClaseColor => Estado switch {
        EstadoCita.PENDIENTE => "text-bg-warning",
        EstadoCita.APROBADO => "text-bg-primary",
        EstadoCita.RECHAZADO => "text-bg-danger",
        EstadoCita.CANCELADO => "text-bg-secondary",
        EstadoCita.COMPLETADO => "text-bg-success",
        _ => "text-bg-light"
    };
}
