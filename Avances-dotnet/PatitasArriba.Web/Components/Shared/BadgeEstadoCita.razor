<span class="estado @ClaseColor">@TextoEnum.De(Estado)</span>

@code {
    [Parameter, EditorRequired]
    public EstadoCita Estado { get; set; }

    // Colores de la paleta C (ver app.css)
    private string ClaseColor => Estado switch {
        EstadoCita.PENDIENTE => "estado-pendiente",
        EstadoCita.APROBADO => "estado-aprobado",
        EstadoCita.RECHAZADO => "estado-rechazado",
        EstadoCita.CANCELADO => "estado-cancelado",
        EstadoCita.COMPLETADO => "estado-completado",
        _ => ""
    };
}
