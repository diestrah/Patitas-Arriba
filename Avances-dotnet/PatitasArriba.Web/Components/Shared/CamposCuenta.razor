@* Datos de la cuenta de usuario dentro del formulario de la persona (cliente, veterinario o administrador).
   Reemplaza a la lista desplegable de cuentas: la cuenta se escribe y se guarda junto con la persona.
   Debe usarse dentro de un EditForm cuyo modelo sea la misma persona (así sus mensajes salen debajo de cada campo). *@
<h5 class="mb-3">Cuenta de usuario</h5>
<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label">Nombre de usuario</label>
        <InputText tabindex="@TabIndexInicial" class="form-control" autocomplete="off" @bind-Value="Persona.NombreUsuario" />
        <ValidationMessage For="() => Persona.NombreUsuario" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Correo electrónico</label>
        <InputText tabindex="@(TabIndexInicial + 1)" type="email" class="form-control" @bind-Value="Persona.Correo" />
        <ValidationMessage For="() => Persona.Correo" />
    </div>
</div>
<div class="row">
    <div class="col-md-6 mb-3">
        <label class="form-label">@(EsNueva ? "Contraseña" : "Nueva contraseña")</label>
        <InputText tabindex="@(TabIndexInicial + 2)" type="password" class="form-control" autocomplete="new-password" @bind-Value="Persona.Password" />
        <div class="form-text">@(EsNueva ? "Entre 8 y 64 caracteres." : "Déjela vacía para mantener la contraseña actual.")</div>
        <ValidationMessage For="() => Persona.Password" />
    </div>
    <div class="col-md-6 mb-3">
        <label class="form-label">Confirmar contraseña</label>
        <InputText tabindex="@(TabIndexInicial + 3)" type="password" class="form-control" autocomplete="new-password" @bind-Value="Persona.ConfirmarPassword" />
        <ValidationMessage For="() => Persona.ConfirmarPassword" />
    </div>
</div>

@code {
    [Parameter, EditorRequired]
    public PersonaViewModel Persona { get; set; } = default!;

    // true al registrar (la contraseña es obligatoria); false al editar
    [Parameter]
    public bool EsNueva { get; set; }

    // Los 4 campos usan tabindex desde este número
    [Parameter]
    public int TabIndexInicial { get; set; } = 1;
}
