@using System.Linq.Expressions
@* Campo de las pantallas de acceso (registro, olvidé contraseña, restablecer): etiqueta, ícono, entrada y mensaje de error
   debajo. Si el tipo es "password" trae el botón para ver u ocultar. Debe usarse dentro de un EditForm.
   Valida al salir del campo (no solo al escribir). Uso: <CampoAcceso Id="correo" Etiqueta="Correo electrónico" Icono="mail" @bind-Value="ViewModel.Correo" /> *@
<div class="campo">
    <label for="@Id">@Etiqueta</label>
    <div class="input-wrap">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            @switch (Icono) {
                case "mail":
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 7 9 6 9-6" />
                    break;
                case "lock":
                    <rect x="4" y="11" width="16" height="10" rx="2" />
                    <path d="M8 11V7a4 4 0 0 1 8 0v4" />
                    break;
                case "user":
                    <circle cx="12" cy="8" r="4" />
                    <path d="M4 21a8 8 0 0 1 16 0" />
                    break;
                case "id":
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <circle cx="9" cy="11" r="2" />
                    <path d="M6 16c.5-1.5 1.7-2 3-2s2.5.5 3 2M15 10h3M15 14h3" />
                    break;
                case "phone":
                    <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z" />
                    break;
            }
        </svg>
        <InputText id="@Id" tabindex="@TabIndex" type="@TipoActual" class="login-input" placeholder="@Placeholder"
                   autocomplete="@Autocompletar" inputmode="@ModoEntrada" maxlength="@MaxLength" @onblur="AlSalir"
                   Value="@Value" ValueChanged="@ValueChanged" ValueExpression="@ValueExpression" />
        @if (EsClave) {
            <button class="eye-btn" type="button" @onclick="() => Visible = !Visible"
                    aria-label="@(Visible ? "Ocultar contraseña" : "Mostrar contraseña")" title="@(Visible ? "Ocultar contraseña" : "Mostrar contraseña")">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7S2 12 2 12z" />
                    <circle cx="12" cy="12" r="3" />
                    @if (Visible) {
                        <path d="M3 3l18 18" />
                    }
                </svg>
            </button>
        }
    </div>
    <ValidationMessage For="ValueExpression" />
</div>

@code {
    [Parameter, EditorRequired] public string Id { get; set; } = "";
    [Parameter, EditorRequired] public string Etiqueta { get; set; } = "";
    [Parameter, EditorRequired] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public Expression<Func<string>>? ValueExpression { get; set; }

    // "mail", "lock", "user", "id" o "phone"
    [Parameter] public string Icono { get; set; } = "user";
    [Parameter] public string Tipo { get; set; } = "text";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? Autocompletar { get; set; }
    [Parameter] public string? ModoEntrada { get; set; }
    [Parameter] public int TabIndex { get; set; }
    [Parameter] public int? MaxLength { get; set; }

    [CascadingParameter] private EditContext? Contexto { get; set; }

    // Al salir del campo se valida, aunque no se haya escrito nada: así el error aparece apenas se hace clic y se sale
    private void AlSalir() {
        if (Contexto != null && ValueExpression != null) {
            Contexto.NotifyFieldChanged(FieldIdentifier.Create(ValueExpression));
        }
    }

    private bool Visible { get; set; }
    private bool EsClave => Tipo == "password";
    private string TipoActual => EsClave && !Visible ? "password" : "text";
}
