<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-bold">Boleta @Boleta.SerieCorrelativo</span>
        @if (Boleta.IsActivo) {
            <span class="estado estado-aprobado">Emitida</span>
        } else {
            <span class="estado estado-rechazado">Anulada</span>
        }
    </div>
    <div class="card-body">
        <TicketBoleta Boleta="Boleta" />
        @if (!Boleta.IsActivo) {
            <div class="alert alert-danger mt-3 mb-0 small">Boleta anulada: ya no se puede imprimir ni modificar. Su número queda registrado.</div>
        }
    </div>
    @if (ChildContent != null) {
        <div class="card-footer d-flex flex-wrap gap-2">
            @ChildContent
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public BoletaViewModel Boleta { get; set; } = default!;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
