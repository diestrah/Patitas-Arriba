@inherits LayoutComponentBase
@inject SesionDemo Sesion;

<nav class="navbar navbar-expand barra-principal px-3 sticky-top">
    <a class="navbar-brand marca-barra" href="">
        <span class="marca-logo">
            <svg viewBox="0 0 64 64" width="20" height="20" fill="currentColor" aria-hidden="true">
                <ellipse cx="32" cy="42" rx="14" ry="12" />
                <ellipse cx="14" cy="26" rx="6" ry="8" transform="rotate(-18 14 26)" />
                <ellipse cx="25" cy="14" rx="6" ry="8" transform="rotate(-6 25 14)" />
                <ellipse cx="39" cy="14" rx="6" ry="8" transform="rotate(6 39 14)" />
                <ellipse cx="50" cy="26" rx="6" ry="8" transform="rotate(18 50 26)" />
            </svg>
        </span>
        <span>Patitas Arriba</span>
    </a>

    @* El menú muestra solo las opciones del rol que inició sesión (ver Seguridad/Permisos.cs) *@
    <ul class="navbar-nav me-auto">
        @foreach (KeyValuePair<string, List<OpcionMenu>> grupo in Permisos.MenuDelRol(Sesion.Rol)) {
            <li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle" type="button" data-bs-toggle="dropdown">
                    <Icono Nombre="@Permisos.IconoDeGrupo(grupo.Key)" /><span>@grupo.Key</span>
                </button>
                <ul class="dropdown-menu">
                    @foreach (OpcionMenu opcion in grupo.Value) {
                        <li>
                            @* "boletas" también coincide con "boletas/nueva": si el grupo tiene una opción hija, la ruta debe ser exacta *@
                            <NavLink class="dropdown-item" href="@opcion.Href" Match="@(TieneOpcionHija(grupo.Value, opcion) ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                <Icono Nombre="@opcion.Icono" /><span>@opcion.Texto</span>
                            </NavLink>
                        </li>
                    }
                </ul>
            </li>
        }
    </ul>

    <ul class="navbar-nav">
        @if (Sesion.Rol != null) {
            <li class="nav-item dropdown">
                <button class="nav-link dropdown-toggle usuario-barra" type="button" data-bs-toggle="dropdown" title="@Sesion.NombreUsuario">
                    <span class="avatar">@Sesion.Iniciales</span>
                    <span class="usuario-texto">
                        <span class="usuario-nombre">@Sesion.NombreCorto</span>
                        <span class="usuario-rol">@TextoEnum.De(Sesion.Rol.Value)</span>
                    </span>
                </button>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><NavLink class="dropdown-item" href="" Match="NavLinkMatch.All"><Icono Nombre="home" /><span>Inicio</span></NavLink></li>
                    <li><hr class="dropdown-divider" /></li>
                    <li>
                        @* POST /cuenta/logout borra la cookie de sesión (Seguridad/SeguridadExtensions.cs) *@
                        <form method="post" action="cuenta/logout">
                            <AntiforgeryToken />
                            <button class="dropdown-item" type="submit">
                                <Icono Nombre="log-out" /><span>Cerrar sesión</span>
                            </button>
                        </form>
                    </li>
                </ul>
            </li>
        } else {
            <li class="nav-item">
                <NavLink class="nav-link" href="login"><Icono Nombre="log-in" /><span>Iniciar sesión</span></NavLink>
            </li>
        }
    </ul>
</nav>

<main class="container mt-4 mb-5">
    @Body
</main>

<div id="blazor-error-ui" data-nosnippet>
    Ocurrió un error inesperado.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    // Hay otra opción del mismo grupo cuya ruta empieza con la de esta (por ejemplo "boletas" y "boletas/nueva")
    private static bool TieneOpcionHija(List<OpcionMenu> opciones, OpcionMenu opcion) {
        return opciones.Any(o => o.Href.StartsWith(opcion.Href + "/"));
    }
}
